{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "landing",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@linyup/landing", "exec", "astro", "dev", "--port", "4322"],
      "port": 4322
    },
    {
      "name": "emulators-worktree",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec", "firebase", "emulators:start",
        "--config", "firebase.worktree.json",
        "--only", "auth,firestore,functions,storage",
        "--project", "demo-linyup"
      ],
      "port": 14000
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:web"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:admin"],
      "port": 3002,
      "autoPort": true
    },
    {
      "name": "admin-sandbox",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:admin:sandbox"],
      "port": 3002,
      "autoPort": true
    }
  ]
}
