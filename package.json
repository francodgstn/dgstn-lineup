{
  "name": "dgstn-lineup",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @lineup/web dev",
    "dev:mobile": "pnpm --filter @lineup/mobile start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "functions:build": "pnpm --filter @lineup/shared run build && pnpm --filter @lineup/functions run build",
    "functions:watch": "pnpm --filter @lineup/functions run watch",
    "emulators:start": "pnpm functions:build && firebase emulators:start --only auth,firestore,functions --project demo-lineup",
    "emulators:seed": "node scripts/emulators-seed.mjs",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:billing": "node scripts/dev-billing.mjs",
    "dev:codespace": "bash scripts/dev.sh",
    "stripe:listen": "stripe listen --forward-to localhost:5001/demo-lineup/europe-west6/handleStripeWebhook"
  },
  "devDependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-tools": "^15.18.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
