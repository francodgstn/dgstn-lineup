{
  "name": "dgstn-lineup",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev:web": "pnpm --filter @linyup/web dev",
    "dev:admin": "pnpm --filter @linyup/admin dev",
    "dev:admin:sandbox": "pnpm --filter @linyup/admin dev:sandbox",
    "dev:landing": "pnpm --filter @linyup/landing dev",
    "dev:mobile": "pnpm --filter student-app start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:merge": "node scripts/i18n-merge.mjs",
    "functions:build": "pnpm --filter @linyup/shared run build && pnpm --filter @linyup/functions run build",
    "functions:watch": "pnpm --filter @linyup/functions run watch",
    "emulators:start": "pnpm functions:build && firebase emulators:start --only auth,firestore,functions,storage --project demo-linyup",
    "emulators:seed": "node scripts/emulators-seed.mjs",
    "emulators:demo": "node scripts/emulators-demo.mjs",
    "emulators:swimli": "node scripts/emulators-demo.mjs swimli",
    "emulators:hmd": "firebase emulators:start --only auth,firestore,functions,storage --import=./snapshots/hmd-migration --export-on-exit=./snapshots/hmd-migration --project demo-linyup",
    "emulators:export:demo": "firebase emulators:export ./snapshots/demo --project demo-linyup",
    "emulators:export:swimli": "firebase emulators:export ./snapshots/swimli --project demo-linyup",
    "emulators:export:hmd": "firebase emulators:export ./snapshots/hmd-migration --project demo-linyup",
    "emulators:all": "firebase emulators:start --only auth,firestore,functions,storage --import=./snapshots/all --export-on-exit=./snapshots/all --project demo-linyup",
    "emulators:export:all": "firebase emulators:export ./snapshots/all --project demo-linyup",
    "stripe:listen": "stripe listen --forward-to localhost:5001/demo-linyup/europe-west6/handleStripeWebhook --forward-connect-to localhost:5001/demo-linyup/europe-west6/handleConnectWebhook",
    "stripe:sync": "tsx scripts/stripe-sync.ts",
    "connect:test-account": "tsx scripts/connect-test-account.ts",
    "migrate:hmd": "tsx --tsconfig tsconfig.scripts.json scripts/migrate-hmd.ts",
    "promote:team": "tsx --tsconfig tsconfig.scripts.json scripts/promote-team.ts",
    "staging:seed": "tsx scripts/seed-staging.ts",
    "staging:reset": "tsx scripts/reset-staging-db.ts --confirm",
    "lead:seed": "tsx scripts/seed-lead.ts",
    "sandbox:seed": "tsx scripts/seed-sandbox.ts",
    "sandbox:reset": "tsx scripts/reset-sandbox-db.ts",
    "purge:team": "tsx --tsconfig tsconfig.scripts.json scripts/purge-team.ts",
    "messaging:policy": "tsx scripts/messaging-policy.ts",
    "backfill:finance": "tsx scripts/backfill-finance-journal.ts",
    "backfill:document-versions": "tsx scripts/backfill-document-versions.ts",
    "audit:document-visibility": "tsx scripts/audit-document-visibility.ts",
    "backfill:document-mirrors": "tsx scripts/backfill-document-mirrors.ts",
    "backfill:subscription-lifecycle": "tsx scripts/backfill-subscription-lifecycle.ts",
    "backfill:gateway-data": "tsx scripts/backfill-gateway-data.ts",
    "typecheck:seeds": "tsc -p tsconfig.seedcheck.json",
    "verify:waiver-ledger": "tsx scripts/verify-waiver-ledger.ts"
  },
  "devDependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-tools": "^15.18.0",
    "prettier": "^3.4.2",
    "stripe": "^22.1.1",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
