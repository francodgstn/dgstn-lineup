# ⚠️  COMMITTED TO GIT + DEPLOYED. The Firebase CLI loads this file by project
# alias on `firebase deploy --project sandbox`, so these values are baked into
# the deployed sandbox functions' config (read via firebase-functions/params,
# e.g. defineString in src/utils/env.ts).
# DO NOT put secrets here (API keys, tokens, passwords). Secrets go to Secret
# Manager and are read via getSecret() (src/utils/secrets.ts); for local-only
# secrets use the gitignored .env.local. Non-secret config only below.
# Outbound mail on the sandbox is governed PER TENANT (messaging_policies/{id},
# see packages/functions/src/mail/README.md "Per-tenant delivery policy"):
#   · lead demos get an operator-set allowlist (only the lead's real addresses)
#   · /try playground teams are hard-silenced by their seeded policy
#   · anything without a policy falls back to MESSAGING_DEFAULT_MODE below.
# The synthetic-recipient guard additionally drops @example.com & friends in
# every environment. TEST_MODE stays OFF here — it would bypass the policies.
MAIL_ENABLED=true
TEST_MODE=false
TEST_EMAIL=
MESSAGING_DEFAULT_MODE=silent
# SMS: hard-disabled until the Brevo account holds SMS credits AND the lead's
# phone is on their tenant allowlist (SMS spends prepaid credits per segment).
SMS_ENABLED=false
TEST_SMS_NUMBER=
# Public demo lives on its own subdomain mapped to the sandbox App Hosting
# backend (entry point: https://demo.linyup.com/try).
HOSTING_URL=https://demo.linyup.com
# Vertex AI location for the in-app assistant (firebase-functions/params).
VERTEX_LOCATION=global
# Mail sender identities (firebase-functions/params defineString in
# src/mail/senderIdentity.ts). These mirror the code defaults, but a
# non-interactive `firebase deploy` requires a value for EVERY param in the
# loaded dotenv — a code default alone is not enough — so they are set
# explicitly here. (Unused while MAIL_ENABLED=false, but still required to deploy.)
MAIL_SYSTEM_FROM=hello@linyup.com
MAIL_SYSTEM_NAME=Linyup
MAIL_MANAGED_STUDIO_FROM=studios@linyup.com
# App Check enforcement for the web-only public callables (checkouts + submitForm).
# false = MONITOR mode (missing tokens logged, not rejected). Keep false in the
# public sandbox/demo so demo checkouts are never blocked.
APP_CHECK_ENFORCE=false

# Custom domains are PRODUCTION ONLY (docs/custom-domains.md → "Environments"):
# one Cloudflare zone has one fallback origin, so a non-prod environment would
# need its own domain, token and Worker deploy. registerPublicDomain refuses here
# before it ever reaches Cloudflare, so these stay deliberately empty — a zone id
# set off-prod is how a sandbox tenant ends up registering on the PROD zone.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_CNAME_TARGET=
