# ⚠️  COMMITTED TO GIT + DEPLOYED. The Firebase CLI loads this file by project
# alias on `firebase deploy --project staging`, so these values are baked into
# the deployed staging functions' config (read via firebase-functions/params,
# e.g. defineString in src/utils/env.ts).
# DO NOT put secrets here (API keys, tokens, passwords). Secrets go to Secret
# Manager and are read via getSecret() (src/utils/secrets.ts); for local-only
# secrets use the gitignored .env.local. Non-secret config only below.
TEST_MODE=true
TEST_EMAIL=franco.dgstn@gmail.com
HOSTING_URL=https://linyup-staging.web.app
# Vertex AI location for the in-app assistant (firebase-functions/params).
VERTEX_LOCATION=global
# Mail config (firebase-functions/params). A non-interactive `firebase deploy`
# requires a value for EVERY param in the loaded dotenv — a code default alone is
# not enough — so all mail params are set explicitly here (values mirror the code
# defaults). Mail is enabled in staging but redirected to TEST_EMAIL (TEST_MODE=true).
MAIL_ENABLED=true
MAIL_SYSTEM_FROM=hello@linyup.com
MAIL_SYSTEM_NAME=Linyup
MAIL_MANAGED_STUDIO_FROM=studios@linyup.com
# Per-tenant messaging policy fallback (tenants without a messaging_policies doc).
# 'live' + TEST_MODE=true above = unchanged staging behavior (global redirect).
MESSAGING_DEFAULT_MODE=live
# SMS off in staging until explicitly needed (prepaid Brevo credits).
SMS_ENABLED=false
TEST_SMS_NUMBER=
# App Check enforcement for the web-only public callables (checkouts + submitForm).
# false = MONITOR mode (missing tokens logged, not rejected). Staging is the place
# to flip this to true first — after the web reCAPTCHA App Check key is provisioned
# and [appcheck-monitor] logs confirm tokens are arriving — before touching prod.
APP_CHECK_ENFORCE=false
