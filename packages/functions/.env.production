# ⚠️  COMMITTED TO GIT + DEPLOYED. The Firebase CLI loads this file by project
# alias on `firebase deploy --project production`, so these values are baked into
# the deployed production functions' config (read via firebase-functions/params,
# e.g. defineString in src/utils/env.ts).
# DO NOT put secrets here (API keys, tokens, passwords). Secrets go to Secret
# Manager and are read via getSecret() (src/utils/secrets.ts); for local-only
# secrets use the gitignored .env.local. Non-secret config only below.
TEST_MODE=false
TEST_EMAIL=
HOSTING_URL=https://linyup.com
# Trial purge is irreversible — keep true (log-only) until verified, then flip.
TRIAL_PURGE_DRY_RUN=true
