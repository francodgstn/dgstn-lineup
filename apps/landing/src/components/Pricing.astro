---
import type { Language } from '~/i18n';
import { useTranslations } from '~/i18n';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const APP_URL = import.meta.env.PUBLIC_APP_URL ?? 'https://app.lineup.io';

const plans = [
  {
    key: 'coach',
    icon: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>`,
  },
  {
    key: 'club',
    icon: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" /></svg>`,
  },
  {
    key: 'org',
    icon: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>`,
  },
] as const;
---

<section id="pricing" class="py-24 bg-gray-50">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="text-center mb-4">
      <span class="inline-flex items-center gap-2 bg-amber-50 border border-amber-200 text-amber-700 text-sm font-medium px-4 py-1.5 rounded-full mb-6">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
        </svg>
        {t('plans.comingSoon')}
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
        {t('plans.title')}
      </h2>
      <p class="text-lg text-gray-500 max-w-xl mx-auto">
        {t('plans.subtitle')}
      </p>
    </div>

    <!-- Plan cards -->
    <div class="grid md:grid-cols-3 gap-6 mt-12">
      {plans.map(({ key, icon }) => (
        <div class="bg-white rounded-2xl border border-gray-200 p-8 flex flex-col items-center text-center">
          <div class="w-14 h-14 rounded-2xl bg-brand-50 text-brand-600 flex items-center justify-center mb-5">
            <Fragment set:html={icon} />
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-2">
            {t(`plans.${key}.name`)}
          </h3>
          <p class="text-sm text-gray-500 leading-relaxed">
            {t(`plans.${key}.audience`)}
          </p>
        </div>
      ))}
    </div>

    <!-- Single CTA -->
    <div class="mt-12 text-center">
      <a
        href={`${APP_URL}/signup`}
        class="inline-flex items-center gap-2 bg-brand-600 text-white font-semibold px-7 py-3 rounded-xl hover:bg-brand-700 transition-colors shadow-lg shadow-brand-600/20"
      >
        {t('plans.earlyAccessCta')}
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
      <p class="mt-3 text-sm text-gray-400">{t('plans.earlyAccessNote')}</p>
    </div>

  </div>
</section>
