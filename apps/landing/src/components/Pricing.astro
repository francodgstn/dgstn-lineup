---
import type { Language } from '~/i18n';
import { useTranslations, useTranslationList } from '~/i18n';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const tList = useTranslationList(lang);

const plans = [
  { key: 'free', featured: false },
  { key: 'coach', featured: false },
  { key: 'studio', featured: true },
  { key: 'org', featured: false },
] as const;

// Full feature comparison (collapsed by default). Columns follow `plans` order:
// [free, coach, studio, organization]. Cell values: true = ✓, false = —, or a
// sentinel/literal string ('unlimited' | 'addon' | 'soon', or a contact count).
// Row labels reuse the already-translated marquee titles where possible.
type CmpVal = boolean | string;
// `feature` (optional) names the marquee feature card a row's label should open
// when clicked — used for rows whose label isn't a `features.cards.<key>.title`
// (so every "Run your studio" row gets the clickable (i) detail modal).
const COMPARE: { heading: string; rows: { label: string; note?: string; feature?: string; values: CmpVal[] }[] }[] = [
  {
    heading: 'plans.cmpUsage',
    rows: [
      { label: 'plans.cmpUiLanguages', note: 'plans.cmpUiLanguagesNote', values: [true, true, true, true] },
      { label: 'plans.cmpContacts', note: 'plans.cmpContactsNote', values: ['15', '50', '250', 'unlimited'] },
      { label: 'plans.cmpMigration', values: [false, true, true, true] },
      { label: 'plans.cmpBranding', values: [false, false, true, true] },
      // Paid plans, mirroring BYO email sending: a DOMAIN is the studio's own
      // identity (in the address bar, and in the From line), which is a
      // different thing from removing Linyup branding from the page above.
      { label: 'features.cards.customDomain.title', values: [false, true, true, true] },
      { label: 'plans.cmpMembers', values: [false, false, true, true] },
    ],
  },
  {
    heading: 'plans.cmpCore',
    rows: [
      { label: 'features.cards.sessions.title', values: [true, true, true, true] },
      { label: 'features.cards.contacts.title', values: [true, true, true, true] },
      { label: 'features.cards.bookings.title', values: [true, true, true, true] },
      { label: 'features.cards.biolink.title', values: [true, true, true, true] },
      { label: 'plans.cmpAppointments', feature: 'appointments', values: [true, true, true, true] },
      { label: 'features.cards.checkins.title', values: [true, true, true, true] },
      { label: 'plans.cmpGoals', feature: 'goals', values: [true, true, true, true] },
      { label: 'features.cards.memberships.title', note: 'plans.cmpSubscriptionsNote', values: [true, true, true, true] },
      { label: 'features.cards.payments.title', values: [true, true, true, true] },
      { label: 'plans.cmpPaymentFee', feature: 'paymentFee', values: [t('payments.feeFree'), t('payments.feeCoach'), t('payments.feeStudio'), t('payments.feeOrg')] },
      { label: 'features.cards.automations.title', note: 'plans.cmpAutomationsNote', values: ['limited', 'limited', true, true] },
      { label: 'features.cards.groups.title', values: [false, true, true, true] },
      { label: 'features.cards.customFields.title', values: [false, true, true, true] },
      { label: 'features.cards.mobileApp.title', values: [false, true, true, true] },
      { label: 'plans.cmpForms', feature: 'forms', values: [false, 'addon', true, true] },
      { label: 'features.cards.gamification.title', values: [false, 'addon', true, true] },
      { label: 'features.cards.referrals.title', values: [false, 'addon', true, true] },
      { label: 'features.cards.courses.title', values: [false, 'addon', true, true] },
      { label: 'features.cards.website.title', note: 'plans.cmpWebsiteNote', values: [false, 'addon', true, true] },
      { label: 'plans.cmpProducts', feature: 'products', values: [false, 'addon', true, true] },
      { label: 'features.cards.finance.title', values: [false, 'addon', true, true] },
      { label: 'features.cards.kiosk.title', values: [false, false, true, true] },
      { label: 'features.cards.analytics.title', values: [false, false, true, true] },
      { label: 'plans.cmpApi', feature: 'api', values: [false, false, true, true] },
      { label: 'features.cards.aiInsights.title', values: [false, false, 'soon', 'soon'] },
      { label: 'features.cards.whatsapp.title', values: [false, false, 'soon', 'soon'] },
    ],
  },
  {
    heading: 'plans.cmpOrg',
    rows: [
      { label: 'plans.cmpMultiTeam', values: [false, false, false, true] },
      { label: 'plans.cmpCentralAdmin', values: [false, false, false, true] },
      { label: 'plans.cmpCrossTeam', values: [false, false, false, true] },
      { label: 'plans.cmpPermissions', values: [false, false, false, true] },
    ],
  },
];

// Per-section ordering: rows that are ✓ for every plan (shared by all) float to
// the top of their section, so the differentiating rows cluster together below
// and the actual differences are easier to scan. Stable within each partition.
const allYes = (vals: CmpVal[]) => vals.every((v) => v === true);
const COMPARE_SORTED = COMPARE.map((group) => ({
  ...group,
  rows: [...group.rows].sort((a, b) => Number(allYes(b.values)) - Number(allYes(a.values))),
}));

// Sentinel/literal → display text; null means render a ✓/— icon instead.
const cmpText = (v: CmpVal): string | null => {
  if (v === 'unlimited') return t('plans.cmpUnlimited');
  if (v === 'addon') return t('plans.cmpAddon');
  if (v === 'limited') return t('plans.cmpLimited');
  if (v === 'soon') return t('plans.cmpSoon');
  return typeof v === 'string' ? v : null;
};
---

<section id="pricing" class="plans-sec">
  <div class="wrap">
    <div class="sec-head">
      <h2>{t('plans.title')}</h2>
      <p>{t('plans.subtitle')}</p>
    </div>

    <div class="plans">
      {
        plans.map(({ key, featured }) => {
          const isFree = key === 'free';
          const isOrg = key === 'org';
          // Coach & Studio carry the 50% launch promo; Org is sales-led
          // ("From CHF X · Talk to us"), no published discount; Free is free.
          const hasPromo = !isFree && !isOrg;
          // Promo cards split the discounted promoPrice; the org card splits its
          // (undiscounted) "From CHF X" price so the currency can sit on its own
          // small line above (keeps the number + /mo on one line).
          const priceSource = isOrg ? 'price' : 'promoPrice';
          const [currency, ...amountParts] = t(`plans.${key}.${priceSource}`).split(' ');
          const amount = amountParts.join(' ');
          return (
          <div class:list={['plan', { featured }]}>
            {featured && <span class="plan-tag">{t('plans.mostPopular')}</span>}
            <h3>{t(`plans.${key}.name`)}</h3>
            <p class="aud">{t(`plans.${key}.audience`)}</p>

            <div class="price-block">
              {isFree ? (
                <span class="amount">{t('plans.free.price')}</span>
              ) : (
                <>
                  <span class="currency">{currency}</span>
                  <div class="amount-line">
                    <span class="amount-row">
                      {isOrg && <span class="from-label">{t('plans.orgFrom')}</span>}
                      <span class="amount">{amount}{hasPromo && <sup class="price-star">*</sup>}</span>
                      <span class="period">{t('plans.perMonth')}</span>
                    </span>
                    {hasPromo && (
                      <span class="price-tag"><i data-lucide="sparkles"></i> {t('plans.promoBadge')}</span>
                    )}
                  </div>
                </>
              )}
            </div>
            {hasPromo && (
              <p class="price-note">
                * {t(`plans.${key}.price`)}{t('plans.perMonth')} {t('plans.afterPromo')}
              </p>
            )}

            <ul class="feat-list">
              {tList(`plans.${key}.features`).map((feat) => (
                <li><i data-lucide="check" /> {feat}</li>
              ))}
            </ul>

            <a class="feat-more" href="#compare" data-open-compare data-plan={key}>
              {t('plans.cmpMore')} <i data-lucide="arrow-down"></i>
            </a>

            <button
              class:list={['btn', 'btn-block', featured ? 'btn-primary' : 'btn-outline']}
              type="button"
              data-early-access
              data-ea-source="pricing"
              data-plan={key}
            >
              {isOrg ? t('plans.talkToUs') : t('plans.earlyAccessCta')}
            </button>
          </div>
          );
        })
      }
    </div>

    <!-- Full feature comparison — collapsed to a faded peek, expand to reveal -->
    <div class="compare" id="compare">
      <div class="compare-body" id="compare-body">
      <div class="compare-scroll">
        <table class="compare-table">
          <thead>
            <tr>
              <th class="feat-col"></th>
              {plans.map(({ key }) => <th>{t(`plans.${key}.name`)}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              COMPARE_SORTED.map((group) => (
                <Fragment>
                  <tr class="cmp-group">
                    <th colspan={plans.length + 1}>{t(group.heading)}</th>
                  </tr>
                  {group.rows.map((row) => {
                    // Rows backed by a marquee feature card (label =
                    // features.cards.<key>.title) get a clickable label that opens
                    // the same detail modal as the feature marquee. Other rows
                    // (plans.cmp*) render as plain text.
                    const featKey =
                      row.feature ??
                      (row.label.startsWith('features.cards.') && row.label.endsWith('.title')
                        ? row.label.slice('features.cards.'.length, -'.title'.length)
                        : null);
                    return (
                    <tr>
                      <th scope="row">
                        {featKey ? (
                          <button type="button" class="feat-link" data-feature-key={featKey}>
                            <span>{t(row.label)}</span>
                            <i data-lucide="info"></i>
                          </button>
                        ) : (
                          t(row.label)
                        )}
                        {row.note && <span class="row-note">{t(row.note)}</span>}
                      </th>
                      {row.values.map((v) => {
                        const txt = cmpText(v);
                        return (
                          <td>
                            {txt !== null ? (
                              <span class="cell-txt">{txt}</span>
                            ) : v === true ? (
                              <span class="cell-yes"><i data-lucide="check"></i></span>
                            ) : (
                              <span class="cell-no">–</span>
                            )}
                          </td>
                        );
                      })}
                    </tr>
                    );
                  })}
                </Fragment>
              ))
            }
          </tbody>
        </table>
      </div>
      </div>
    </div>
    <div class="compare-toggle-wrap">
      <button class="compare-toggle" type="button" aria-expanded="false" aria-controls="compare-body">
        <span>{t('plans.cmpToggle')}</span>
        <i data-lucide="chevron-down"></i>
      </button>
    </div>

    <!-- A light "challenge us" invitation after the comparison — deliberately
         low-key (no card chrome), nudging people to tell us what they're missing. -->
    <div class="challenge">
      <p class="challenge-title">{t('plans.challengeTitle')}</p>
      <p class="challenge-body">{t('plans.challengeBody')}</p>
      <button class="challenge-cta" type="button" data-early-access data-ea-source="pricing-challenge">
        {t('plans.challengeCta')} <i data-lucide="arrow-right"></i>
      </button>
    </div>
  </div>
</section>

<script>
  // PostHog (loaded globally in BaseLayout). Optional: no-op when analytics is off.
  type Capture = (event: string, props?: Record<string, unknown>) => void;
  const ph = (): Capture | undefined =>
    (window as unknown as { posthog?: { capture: Capture } }).posthog?.capture.bind(
      (window as unknown as { posthog?: { capture: Capture } }).posthog,
    );

  const cmp = document.querySelector('.compare');
  const btn = document.querySelector('.compare-toggle');
  btn?.addEventListener('click', () => {
    const open = cmp!.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(open));
    ph()?.('pricing_compare_toggled', { expanded: open });
  });

  // "See the full comparison" links inside the plan cards — expand the table and
  // scroll to it (the cards only list a few headline features).
  document.querySelectorAll<HTMLAnchorElement>('[data-open-compare]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      cmp?.classList.add('open');
      btn?.setAttribute('aria-expanded', 'true');
      document.getElementById('compare')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      ph()?.('pricing_compare_opened', { source: 'plan_card', plan: el.dataset.plan });
    });
  });

  // Clickable feature labels → open the shared feature-detail modal (defined in
  // Features.astro, which renders on the same page).
  document.querySelectorAll<HTMLElement>('.compare-table .feat-link').forEach((el) => {
    el.addEventListener('click', () => {
      const key = el.dataset.featureKey;
      ph()?.('pricing_feature_viewed', { feature: key });
      const opener = (window as unknown as { openFeatureModal?: (k: string) => void })
        .openFeatureModal;
      if (key && opener) opener(key);
    });
  });
</script>

<style>
  .plans-sec { padding: 120px 0; background: var(--purple-50); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  /* Comfortable gap between the section head and the cards (the old chip row
     used to bridge this space). */
  .plans-sec .sec-head { margin-bottom: 56px; }

  .plans { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; align-items: stretch; }
  .plan { background: var(--card); border-radius: var(--radius-xl); box-shadow: var(--ring-card), var(--shadow-sm); padding: 38px 30px; display: flex; flex-direction: column; }
  .plan.featured { box-shadow: var(--shadow-lg); border: 2px solid var(--primary); position: relative; }
  .plan-tag { position: absolute; top: -11px; left: 28px; background: var(--primary); color: #fff; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; padding: 3px 10px; border-radius: 99px; }
  .plan h3 { font-family: var(--font-display); font-weight: 600; font-size: 26px; }
  .plan .aud { font-size: 14px; color: var(--muted-foreground); margin: 8px 0 16px; min-height: 60px; }

  /* Price block — currency on its own small line, then amount + /mo (no wrap) */
  .price-block { display: flex; flex-direction: column; align-items: flex-start; gap: 3px; }
  .currency { font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted-foreground); line-height: 1; }
  .amount-line { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; }
  .amount-row { display: inline-flex; align-items: baseline; gap: 5px; white-space: nowrap; }
  .amount { font-family: var(--font-display); font-weight: 600; font-size: 34px; line-height: 1; color: var(--heading); }
  .from-label { align-self: center; font-size: 14px; font-weight: 500; color: var(--muted-foreground); margin-right: 4px; }
  .price-star { color: var(--primary); font-weight: 700; font-size: 0.5em; }
  .period { font-size: 14px; font-weight: 500; color: var(--muted-foreground); }

  /* "Offer" chip next to the discounted price */
  .price-tag {
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--purple-700);
    background: var(--purple-50);
    border: 1px solid var(--purple-200);
    padding: 3px 9px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }
  .price-tag :global(svg) { width: 12px; height: 12px; }
  .plan.featured .price-tag { background: var(--primary); color: #fff; border-color: transparent; }

  /* Regular price after the promo period (paid cards) */
  .price-note { margin: 6px 0 0; font-size: 13px; color: var(--muted-foreground); }

  .feat-list { list-style: none; padding: 0; margin: 20px 0 0; display: flex; flex-direction: column; gap: 10px; }
  .feat-list li { display: flex; align-items: center; gap: 9px; font-size: 13.5px; }
  .feat-list :global(svg) { width: 16px; height: 16px; color: var(--success-fg); flex-shrink: 0; }

  /* Muted link to the full comparison — the card only lists a few headline rows */
  .feat-more {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    /* Sits between the feature list and the CTA — keep a clear gap below it so
       it never crowds the button (notably on mobile, where cards stack). */
    margin: 16px 0 22px;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--muted-foreground);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .feat-more:hover { color: var(--primary); }
  .feat-more :global(svg) { width: 13px; height: 13px; }

  /* CTA pinned to the bottom so cards with differing content stay aligned. The
     auto top margin still leaves at least the .feat-more bottom gap above it. */
  .plan .btn { margin-top: auto; }

  @media (max-width: 1100px) {
    .plans { grid-template-columns: repeat(2, 1fr); }
  }

  /* ── Feature comparison (collapsible) ────────────────────────────────── */
  /* No card chrome — when collapsed the table simply dissolves into the section
     background, and the toggle sits below as a detached button. */
  .compare { margin-top: 60px; }
  /* Collapsed: a taller "peek" (a few more rows) that fades fully into the
     section background at the bottom. */
  .compare-body {
    max-height: 400px;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 62%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0, #000 62%, transparent 100%);
  }
  .compare.open .compare-body {
    max-height: none;
    overflow: visible;
    -webkit-mask-image: none;
    mask-image: none;
  }
  /* Detached toggle — a standalone pill button under the table, not a table row */
  .compare-toggle-wrap { display: flex; justify-content: center; margin-top: 28px; }
  .compare-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 24px;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    color: var(--primary);
    background: var(--card);
    border: 1px solid var(--purple-200);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-sm);
    cursor: pointer;
    user-select: none;
    transition: background 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .compare-toggle:hover { background: var(--purple-50); transform: translateY(-1px); box-shadow: var(--shadow-md); }
  .compare-toggle :global(svg) { width: 16px; height: 16px; transition: transform 0.2s ease; }
  .compare-toggle[aria-expanded="true"] :global(svg) { transform: rotate(180deg); }

  .compare-scroll { overflow-x: auto; }
  .compare-table { width: 100%; border-collapse: collapse; font-size: 14px; min-width: 660px; }
  .compare-table th,
  .compare-table td { padding: 11px 16px; text-align: center; border-top: 1px solid var(--border); }
  .compare-table thead th { font-family: var(--font-display); font-size: 16px; color: var(--heading); }
  .compare-table thead th:first-child { border-top: 0; }
  .compare-table tbody th[scope='row'] { text-align: left; font-weight: 500; color: var(--foreground); }
  .row-note { display: block; margin-top: 3px; font-size: 11.5px; font-weight: 400; line-height: 1.4; color: var(--muted-foreground); max-width: 30ch; }

  /* Clickable feature label (opens the shared feature-detail modal) */
  .feat-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }
  .feat-link > span {
    text-decoration: underline dotted var(--border);
    text-underline-offset: 3px;
  }
  .feat-link:hover > span { color: var(--primary); text-decoration-color: var(--primary); }
  .feat-link :global(svg) { width: 13px; height: 13px; color: var(--muted-foreground); opacity: 0.55; flex-shrink: 0; }
  .feat-link:hover :global(svg) { color: var(--primary); opacity: 1; }
  .feat-link:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; border-radius: 4px; }
  .cmp-group th {
    text-align: left;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--purple-700);
    background: var(--purple-100);
  }
  .cell-yes { color: var(--success-fg); display: inline-flex; }
  .cell-yes :global(svg) { width: 18px; height: 18px; }
  .cell-no { color: var(--muted-foreground); opacity: 0.45; }
  .cell-txt { font-size: 13px; font-weight: 600; color: var(--foreground); }

  /* "Challenge us" — a quiet invitation after the comparison, not a card/banner */
  .challenge {
    margin: 40px auto 0;
    max-width: 560px;
    text-align: center;
    padding: 22px 26px;
    border: 1px dashed var(--border);
    border-radius: var(--radius-xl);
    background: color-mix(in oklch, var(--primary) 4%, transparent);
  }
  .challenge-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 17px;
    color: var(--foreground);
  }
  .challenge-body {
    margin-top: 6px;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--muted-foreground);
  }
  .challenge-cta {
    margin-top: 14px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font: inherit;
    font-weight: 600;
    font-size: 14px;
    color: var(--primary);
    background: none;
    border: 0;
    cursor: pointer;
  }
  .challenge-cta:hover { text-decoration: underline; text-underline-offset: 3px; }
  .challenge-cta :global(svg) { width: 15px; height: 15px; transition: transform 0.15s ease; }
  .challenge-cta:hover :global(svg) { transform: translateX(2px); }

  @media (max-width: 860px) {
    .plans-sec { padding: 72px 0; }
    .plans-sec .sec-head { margin-bottom: 40px; }
    .plans { grid-template-columns: 1fr; gap: 20px; }
    /* A bit more room around each card's CTA when cards stack vertically. */
    .feat-more { margin: 16px 0 24px; }
    .plan { padding: 34px 26px; }
  }
</style>
