---
import type { Language } from '~/i18n';
import { useTranslations } from '~/i18n';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="cta-band">
  <div class="wrap">
    <div class="cta-inner">
      <h2>{t('cta.title')}</h2>
      <p>{t('cta.subtitle')}</p>
      <button class="btn btn-white btn-lg" type="button" data-early-access>
        {t('cta.button')} <i data-lucide="arrow-right"></i>
      </button>
    </div>
  </div>
</section>

<style>
  .cta-band { padding: 104px 0; text-align: center; }
  .cta-inner {
    background: var(--purple-900);
    color: #fff;
    border-radius: 24px;
    padding: 64px 32px;
    background-image: radial-gradient(circle at 80% 20%, var(--purple-700), transparent 60%);
  }
  .cta-inner h2 { font-family: "Sora", var(--font-sans); font-weight: 700; font-size: 40px; color: #fff; }
  .cta-inner p { font-size: 17px; opacity: 0.85; margin: 14px auto 28px; max-width: 50ch; }
  .cta-inner .btn-white { display: inline-flex; }

  @media (max-width: 860px) {
    .cta-band { padding: 68px 0; }
    .cta-inner { padding: 48px 20px; }
    .cta-inner h2 { font-size: 30px; }
  }
</style>
