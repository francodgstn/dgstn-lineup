---
import type { Language } from '~/i18n';
import { useTranslations } from '~/i18n';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const featureList = [
  { key: 'sessions', icon: 'calendar-range' },
  { key: 'contacts', icon: 'users' },
  { key: 'mobile', icon: 'smartphone' },
] as const;
---

<section id="features">
  <div class="wrap">
    <div class="sec-head">
      <h2>{t('features.title')}</h2>
      <p>{t('features.subtitle')}</p>
    </div>
    <div class="features">
      {
        featureList.map(({ key, icon }) => (
          <div class="feature">
            <div class="ficon"><i data-lucide={icon} /></div>
            <h3>{t(`features.${key}.title`)}</h3>
            <p>{t(`features.${key}.description`)}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  section { padding: 80px 0; }
  .features { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .feature { background: var(--card); border-radius: var(--radius-xl); box-shadow: var(--ring-card), var(--shadow-sm); padding: 28px; }
  .ficon { width: 48px; height: 48px; border-radius: 12px; background: var(--purple-50); color: var(--primary); display: flex; align-items: center; justify-content: center; border: 1px solid var(--purple-100); }
  .ficon :global(svg) { width: 24px; height: 24px; }
  .feature h3 { font-family: var(--font-display); font-weight: 600; font-size: 22px; margin: 18px 0 8px; }
  .feature p { font-size: 14.5px; line-height: 1.6; color: var(--muted-foreground); margin: 0; }

  @media (max-width: 860px) {
    section { padding: 56px 0; }
    .features { grid-template-columns: 1fr; }
  }
</style>
