---
import type { Language } from '~/i18n';
import { useTranslations } from '~/i18n';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const featureList = [
  {
    key: 'sessions',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>`,
    color: 'bg-indigo-50 text-indigo-600',
  },
  {
    key: 'contacts',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" /></svg>`,
    color: 'bg-emerald-50 text-emerald-600',
  },
  {
    key: 'mobile',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>`,
    color: 'bg-violet-50 text-violet-600',
  },
] as const;
---

<section id="features" class="py-24 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
        {t('features.title')}
      </h2>
      <p class="text-lg text-gray-500 max-w-2xl mx-auto">
        {t('features.subtitle')}
      </p>
    </div>

    <!-- Feature cards -->
    <div class="grid md:grid-cols-3 gap-8">
      {
        featureList.map(({ key, icon, color }) => (
          <div class="relative group p-8 rounded-2xl border border-gray-100 bg-gray-50 hover:bg-white hover:shadow-lg hover:border-gray-200 transition-all duration-200">
            <!-- Icon -->
            <div class:list={['w-12 h-12 rounded-xl flex items-center justify-center mb-5', color]}>
              <Fragment set:html={icon} />
            </div>

            <!-- Title -->
            <h3 class="text-lg font-semibold text-gray-900 mb-3">
              {t(`features.${key}.title`)}
            </h3>

            <!-- Description -->
            <p class="text-gray-500 leading-relaxed text-sm">
              {t(`features.${key}.description`)}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
