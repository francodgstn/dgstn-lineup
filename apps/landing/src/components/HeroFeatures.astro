---
import type { Language } from '~/i18n';
import { useTranslations } from '~/i18n';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// The 8 hero features — the day-to-day essentials, shown directly under the hero
// as calm, static cards (no marquee). Labels are verb + benefit; copy lives in
// heroFeatures.cards.<key>.{title,benefit}. The full breadth is in the marquee
// further down (Features.astro, "Everything else Linyup does").
const cards = [
  { key: 'sessions', icon: 'calendar-range' },
  { key: 'bookings', icon: 'clipboard-list' },
  { key: 'memberships', icon: 'badge-check' },
  { key: 'payments', icon: 'credit-card' },
  { key: 'rankings', icon: 'medal' },
  { key: 'mobileApp', icon: 'smartphone' },
  { key: 'checkins', icon: 'qr-code' },
  { key: 'automations', icon: 'workflow' },
] as const;
---

<section id="features" class="hf">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow"><i data-lucide="sparkles"></i> {t('heroFeatures.eyebrow')}</span>
      <h2>{t('heroFeatures.title')}</h2>
      <p>{t('heroFeatures.subtitle')}</p>
    </div>

    <div class="hf-grid">
      {
        cards.map(({ key, icon }) => (
          <div class="hf-card">
            <div class="hf-icon"><i data-lucide={icon} /></div>
            <h3>{t(`heroFeatures.cards.${key}.title`)}</h3>
            <p>{t(`heroFeatures.cards.${key}.benefit`)}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hf { padding: 64px 0 16px; }

  /* Eyebrow above the shared section heading */
  .sec-head .eyebrow { margin-bottom: 16px; }

  .hf-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  /* Calm, spacious card — hairline border + soft shadow, gentle lift on hover */
  .hf-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    background: var(--card);
    border-radius: var(--radius-xl);
    box-shadow: var(--ring-card), var(--shadow-sm);
    padding: 26px 24px;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .hf-card:hover { transform: translateY(-3px); box-shadow: var(--ring-card), var(--shadow-md); }

  .hf-icon {
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: var(--purple-50);
    color: var(--primary);
    border: 1px solid var(--purple-100);
    margin-bottom: 18px;
  }
  .hf-icon :global(svg) { width: 26px; height: 26px; }

  .hf-card h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
    line-height: 1.25;
    margin: 0 0 7px;
  }
  .hf-card p {
    font-size: 14px;
    line-height: 1.55;
    color: var(--muted-foreground);
    margin: 0;
    text-wrap: pretty;
  }

  @media (max-width: 1100px) {
    .hf-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 860px) {
    .hf { padding: 40px 0 8px; }
  }
  @media (max-width: 480px) {
    .hf-grid { grid-template-columns: 1fr; }
  }
</style>
