---
import type { Language } from '~/i18n';
import { useTranslations } from '~/i18n';
import schedule from '../assets/product/schedule.webp';
import contact from '../assets/product/contact.webp';
import courses from '../assets/product/courses.webp';
import biolink from '../assets/product/biolink.webp';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Real screens from the martial-arts demo studio. Copy lives in
// showcase.shots.<key>.{title,detail}; icons are Lucide names.
const shots = [
  { key: 'schedule', img: schedule, icon: 'calendar-days' },
  { key: 'contact', img: contact, icon: 'user-round' },
  { key: 'courses', img: courses, icon: 'graduation-cap' },
  { key: 'biolink', img: biolink, icon: 'link' },
] as const;
---

<section id="showcase" class="showcase">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow"><i data-lucide="play"></i> {t('showcase.eyebrow')}</span>
      <h2>{t('showcase.title')}</h2>
      <p>{t('showcase.subtitle')}</p>
    </div>

    <div class="showcase-grid">
      {
        shots.map(({ key, img, icon }) => (
          <figure class="shot">
            <button
              class="shot-frame"
              type="button"
              data-full={img.src}
              aria-label={`${t(`showcase.shots.${key}.title`)} — enlarge`}
            >
              <img
                src={img.src}
                width={img.width}
                height={img.height}
                alt={t(`showcase.shots.${key}.title`)}
                loading="lazy"
                decoding="async"
              />
              <span class="shot-zoom" aria-hidden="true"><i data-lucide="expand" /></span>
            </button>
            <figcaption class="shot-cap">
              <span class="shot-icon"><i data-lucide={icon} /></span>
              <div>
                <h3>{t(`showcase.shots.${key}.title`)}</h3>
                <p>{t(`showcase.shots.${key}.detail`)}</p>
              </div>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <a class="showcase-more" href="#more-features">
      <span>{t('showcase.more')}</span>
      <i data-lucide="arrow-down"></i>
    </a>
  </div>

  <!-- Lightbox — opened by clicking a shot -->
  <div class="lightbox" id="showcase-lightbox" hidden>
    <button class="lightbox-close" type="button" aria-label="Close"><i data-lucide="x"></i></button>
    <img class="lightbox-img" id="showcase-lightbox-img" alt="" />
  </div>
</section>

<script>
  const lb = document.getElementById('showcase-lightbox');
  const lbImg = document.getElementById('showcase-lightbox-img') as HTMLImageElement | null;
  if (lb && lbImg) {
    const open = (src: string, alt: string) => {
      lbImg.src = src;
      lbImg.alt = alt;
      lb.hidden = false;
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      lb.hidden = true;
      lbImg.removeAttribute('src');
      document.body.style.overflow = '';
    };
    document.querySelectorAll<HTMLElement>('.shot-frame[data-full]').forEach((b) => {
      b.addEventListener('click', () => open(b.dataset.full || '', b.querySelector('img')?.getAttribute('alt') || ''));
    });
    lb.querySelector('.lightbox-close')?.addEventListener('click', close);
    lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !lb.hidden) close(); });
  }
</script>

<style>
  .showcase { padding: 72px 0; }
  .sec-head .eyebrow { margin-bottom: 16px; }

  .showcase-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }

  .shot { margin: 0; }

  /* "And more to explore" — nudges the visitor down to the features marquee. */
  .showcase-more {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 36px auto 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 16px;
    color: var(--primary);
    text-decoration: none;
    transition: gap 0.15s ease;
  }
  .showcase-more:hover { gap: 12px; }
  .showcase-more :global(svg) { width: 18px; height: 18px; animation: more-bob 1.8s ease-in-out infinite; }
  @keyframes more-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(3px); } }
  @media (prefers-reduced-motion: reduce) { .showcase-more :global(svg) { animation: none; } }

  /* Frame is a button — click to open the lightbox */
  .shot-frame {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--ring-card), var(--shadow-md);
    background: var(--card);
    cursor: zoom-in;
    font-family: inherit;
    transition: transform 0.16s ease, box-shadow 0.16s ease;
  }
  .shot-frame:hover { transform: translateY(-3px); box-shadow: var(--ring-card), var(--shadow-lg); }
  .shot-frame:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }
  .shot-frame img { display: block; width: 100%; height: auto; }

  .shot-zoom {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border-radius: 8px;
    background: color-mix(in oklch, var(--card) 78%, transparent);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    border: 1px solid var(--border);
    color: var(--foreground);
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.16s ease, transform 0.16s ease;
  }
  .shot-frame:hover .shot-zoom,
  .shot-frame:focus-visible .shot-zoom { opacity: 1; transform: none; }
  .shot-zoom :global(svg) { width: 15px; height: 15px; }

  .shot-cap { display: flex; gap: 12px; align-items: flex-start; margin-top: 16px; }
  .shot-icon {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: var(--purple-50);
    color: var(--primary);
    border: 1px solid var(--purple-100);
  }
  .shot-icon :global(svg) { width: 19px; height: 19px; }
  .shot-cap h3 { font-family: var(--font-display); font-weight: 600; font-size: 17px; margin: 0 0 3px; }
  .shot-cap p { font-size: 13.5px; line-height: 1.5; color: var(--muted-foreground); margin: 0; }

  /* ── Lightbox ────────────────────────────────────────────────────────── */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 130;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px;
    background: oklch(0 0 0 / 0.78);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    animation: lb-fade 0.15s ease;
  }
  .lightbox[hidden] { display: none; }
  .lightbox-img {
    max-width: min(1200px, 94vw);
    max-height: 90vh;
    width: auto;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    animation: lb-pop 0.18s ease;
  }
  .lightbox-close {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 10px;
    background: color-mix(in oklch, white 16%, transparent);
    color: #fff;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .lightbox-close:hover { background: color-mix(in oklch, white 30%, transparent); }
  .lightbox-close :global(svg) { width: 22px; height: 22px; }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lb-pop { from { opacity: 0; transform: scale(0.97); } to { opacity: 1; transform: none; } }

  @media (max-width: 860px) {
    .showcase { padding: 56px 0; }
    .showcase-grid { grid-template-columns: 1fr; gap: 24px; }
  }
</style>
