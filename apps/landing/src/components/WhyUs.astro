---
import type { Language } from '~/i18n';
import { useTranslations, useTranslationList } from '~/i18n';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const tList = useTranslationList(lang);

// Each point is "Lead — explanation"; the lead is emphasised in the markup.
const points = tList('whyUs.points');
---

<section id="why" class="why-sec">
  <div class="wrap">
    <div class="sec-head">
      <h2>{t('whyUs.title')}</h2>
      <p>{t('whyUs.subtitle')}</p>
    </div>

    <ul class="why-list">
      {
        points.map((p) => {
          const [lead, ...rest] = p.split(' — ');
          const body = rest.join(' — ');
          return (
            <li>
              <span class="why-check"><i data-lucide="check"></i></span>
              <span class="why-text">
                {body ? (
                  <>
                    <strong>{lead}</strong> — {body}
                  </>
                ) : (
                  p
                )}
              </span>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .why-sec { padding: 100px 0; }
  .why-sec .sec-head { margin-bottom: 44px; text-align: center; }

  .why-list {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    max-width: 940px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px 44px;
  }
  .why-list li { display: flex; align-items: flex-start; gap: 14px; }

  .why-check {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    margin-top: 1px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--success-fg);
    background: color-mix(in oklch, var(--success-fg) 14%, transparent);
  }
  .why-check :global(svg) { width: 15px; height: 15px; }

  .why-text { font-size: 15.5px; line-height: 1.55; color: var(--muted-foreground); }
  .why-text strong { color: var(--foreground); font-weight: 600; }

  @media (max-width: 760px) {
    .why-sec { padding: 72px 0; }
    .why-list { grid-template-columns: 1fr; gap: 16px; }
  }
</style>
