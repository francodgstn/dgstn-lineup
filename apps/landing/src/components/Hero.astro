---
import type { Language } from '~/i18n';
import { useTranslations, getLocalizedPath } from '~/i18n';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const APP_URL = import.meta.env.PUBLIC_APP_URL ?? 'https://app.lineup.io';
---

<section class="relative overflow-hidden bg-gradient-to-br from-brand-50 via-white to-indigo-50 pt-24 pb-20 sm:pt-32 sm:pb-28">
  <!-- Background decoration -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute -top-40 -right-32 w-[600px] h-[600px] rounded-full bg-brand-100/40 blur-3xl"></div>
    <div class="absolute -bottom-40 -left-32 w-[500px] h-[500px] rounded-full bg-indigo-100/30 blur-3xl"></div>
  </div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <!-- Tagline pill -->
    <div class="inline-flex items-center gap-2 bg-brand-50 border border-brand-200 rounded-full px-4 py-1.5 text-sm font-medium text-brand-700 mb-8">
      <span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span>
      {t('hero.tagline')}
    </div>

    <!-- Headline -->
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-gray-900 max-w-4xl mx-auto mb-6 leading-tight">
      {t('hero.title')}
    </h1>

    <!-- Subtitle -->
    <p class="text-lg sm:text-xl text-gray-600 max-w-2xl mx-auto mb-10 leading-relaxed">
      {t('hero.subtitle')}
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={`${APP_URL}/signup`}
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-brand-600 text-white font-semibold text-base px-8 py-3.5 rounded-xl hover:bg-brand-700 transition-colors shadow-lg shadow-brand-600/20"
      >
        {t('hero.cta')}
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>

      <a
        href={getLocalizedPath('/#features', lang)}
        class="w-full sm:w-auto inline-flex items-center justify-center text-base font-semibold text-gray-700 hover:text-brand-600 transition-colors px-6 py-3.5"
      >
        {t('hero.ctaSecondary')}
        <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </a>
    </div>

    <!-- Social proof strip -->
    <p class="mt-10 text-sm text-gray-400">
      🚀 Early access — be among the first coaches to try Lineup
    </p>
  </div>
</section>
