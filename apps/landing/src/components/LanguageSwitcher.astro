---
import { languages, defaultLang, stripLocale } from '~/i18n';
import type { Language } from '~/i18n';

interface Props {
  currentLang: Language;
}

const { currentLang } = Astro.props;
const currentPath = stripLocale(Astro.url.pathname);

function hrefForLang(lang: Language): string {
  if (lang === defaultLang) return currentPath || '/';
  const clean = currentPath.replace(/^\//, '').replace(/\/$/, '');
  return clean ? `/${lang}/${clean}` : `/${lang}`;
}

const options = (Object.keys(languages) as Language[]).map((lang) => ({
  lang,
  label: lang.toUpperCase(),
  href: hrefForLang(lang),
  selected: lang === currentLang,
}));
---

<div class="ls-wrap">
  <select id="lang-select" aria-label="Language" class="ls-select">
    {options.map(({ label, href, selected }) => (
      <option value={href} selected={selected}>{label}</option>
    ))}
  </select>
  <span class="ls-chevron" aria-hidden="true">
    <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </span>
</div>

<style>
  .ls-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  .ls-select {
    appearance: none;
    background: var(--card);
    border: 1px solid var(--border);
    color: var(--muted-foreground);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    height: 34px;
    padding: 0 28px 0 10px;
    border-radius: var(--radius-lg);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
    line-height: 1;
  }
  .ls-select:hover {
    border-color: var(--primary);
    color: var(--foreground);
  }
  .ls-select:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 2px color-mix(in oklch, var(--primary) 25%, transparent);
  }
  .ls-select option {
    background: var(--card);
    color: var(--foreground);
  }
  .ls-chevron {
    position: absolute;
    right: 8px;
    pointer-events: none;
    color: var(--muted-foreground);
    display: flex;
    align-items: center;
  }
</style>

<script>
  document.getElementById('lang-select')?.addEventListener('change', (e) => {
    const target = e.target as HTMLSelectElement;
    if (target.value) window.location.href = target.value;
  });
</script>
