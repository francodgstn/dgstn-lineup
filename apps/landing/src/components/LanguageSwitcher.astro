---
import { languages, defaultLang, stripLocale } from '~/i18n';
import type { Language } from '~/i18n';

interface Props {
  currentLang: Language;
}

const { currentLang } = Astro.props;
const currentPath = stripLocale(Astro.url.pathname);

function hrefForLang(lang: Language): string {
  if (lang === defaultLang) return currentPath || '/';
  const clean = currentPath.replace(/^\//, '').replace(/\/$/, '');
  return clean ? `/${lang}/${clean}` : `/${lang}`;
}
---

<div class="flex items-center gap-1">
  {
    (Object.keys(languages) as Language[]).map((lang) => (
      <a
        href={hrefForLang(lang)}
        aria-label={languages[lang]}
        class:list={[
          'px-2 py-1 rounded text-sm font-medium transition-colors',
          lang === currentLang
            ? 'text-brand-600 bg-brand-50'
            : 'text-gray-500 hover:text-gray-900 hover:bg-gray-100',
        ]}
        aria-current={lang === currentLang ? 'true' : undefined}
      >
        {lang.toUpperCase()}
      </a>
    ))
  }
</div>
