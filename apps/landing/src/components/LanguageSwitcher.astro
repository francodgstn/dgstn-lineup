---
import { languages, defaultLang, stripLocale } from '~/i18n';
import type { Language } from '~/i18n';

interface Props {
  currentLang: Language;
  /** 'nav' (light bg) or 'footer' (dark bg) */
  variant?: 'nav' | 'footer';
}

const { currentLang, variant = 'nav' } = Astro.props;
const currentPath = stripLocale(Astro.url.pathname);

function hrefForLang(lang: Language): string {
  if (lang === defaultLang) return currentPath || '/';
  const clean = currentPath.replace(/^\//, '').replace(/\/$/, '');
  return clean ? `/${lang}/${clean}` : `/${lang}`;
}

const options = (Object.keys(languages) as Language[]).map((lang) => ({
  lang,
  label: lang.toUpperCase(),
  href: hrefForLang(lang),
  selected: lang === currentLang,
}));
---

<div class="relative">
  <select
    id="lang-select"
    aria-label="Language"
    class:list={[
      'appearance-none text-sm font-medium rounded-lg pl-3 pr-7 py-1.5 cursor-pointer',
      'border focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent',
      'transition-colors',
      variant === 'footer'
        ? 'bg-gray-800 border-gray-700 text-gray-300 hover:border-gray-500'
        : 'bg-white border-gray-200 text-gray-700 hover:border-gray-300',
    ]}
  >
    {options.map(({ label, href, selected }) => (
      <option value={href} selected={selected}>{label}</option>
    ))}
  </select>

  <!-- Chevron icon -->
  <span
    class:list={[
      'pointer-events-none absolute inset-y-0 right-2 flex items-center',
      variant === 'footer' ? 'text-gray-500' : 'text-gray-400',
    ]}
    aria-hidden="true"
  >
    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </span>
</div>

<script>
  document.getElementById('lang-select')?.addEventListener('change', (e) => {
    const target = e.target as HTMLSelectElement;
    if (target.value) window.location.href = target.value;
  });
</script>
