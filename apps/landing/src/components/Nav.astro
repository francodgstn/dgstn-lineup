---
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import type { Language } from '~/i18n';
import { useTranslations, getLocalizedPath } from '~/i18n';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const APP_URL = import.meta.env.PUBLIC_APP_URL ?? 'https://app.linyup.com';
const DEMO_URL = import.meta.env.PUBLIC_DEMO_URL ?? 'https://demo.linyup.com';

// Demo studios for the "Live demo" dropdown — same targets/labels/order as the
// hero chips. Equal peers, martial arts not first.
const DEMO_STUDIOS = [
  { key: 'dance', accent: '#db2777' },
  { key: 'crossfit', accent: '#0f172a' },
  { key: 'yoga', accent: '#9333ea' },
  { key: 'tennis', accent: '#16a34a' },
  { key: 'pilates', accent: '#0d9488' },
  { key: 'grappling', accent: '#dc2626' },
] as const;
---

<header>
  <div class="wrap nav">
    <a href={getLocalizedPath('/', lang)} class="brand" aria-label={t('site.name')}>
      <Logo size={22} />
    </a>

    <nav class="nav-links">
      <a href={getLocalizedPath('/#features', lang)}>{t('nav.features')}</a>
      <a href={getLocalizedPath('/#pricing', lang)}>{t('nav.pricing')}</a>
      <div class="nav-dropdown">
        <button type="button" class="nav-dropdown-trigger" aria-haspopup="true">
          {t('nav.demo')} <i data-lucide="chevron-down"></i>
        </button>
        <div class="nav-dropdown-menu">
          {
            DEMO_STUDIOS.map((studio) => (
              <a
                href={`${DEMO_URL}/preview?team=${studio.key}`}
                target="_blank"
                rel="noopener"
                style={`--chip-accent: ${studio.accent}`}
              >
                <span class="dot"></span>
                {t(`hero.demoStudios.${studio.key}`)}
              </a>
            ))
          }
        </div>
      </div>
    </nav>

    <div class="nav-right">
      <LanguageSwitcher currentLang={lang} />
      <button id="theme-toggle" class="theme-btn" aria-label="Switch theme (light, dark, system)" type="button">
        <!-- Each icon marks the CURRENT mode; click cycles light → dark → system -->
        <svg id="icon-sun" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="5" /><line x1="12" y1="1" x2="12" y2="3" /><line x1="12" y1="21" x2="12" y2="23" /><line x1="4.22" y1="4.22" x2="5.64" y2="5.64" /><line x1="18.36" y1="18.36" x2="19.78" y2="19.78" /><line x1="1" y1="12" x2="3" y2="12" /><line x1="21" y1="12" x2="23" y2="12" /><line x1="4.22" y1="19.78" x2="5.64" y2="18.36" /><line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
        <svg id="icon-moon" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
        <svg id="icon-system" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="3" width="20" height="14" rx="2" /><line x1="8" y1="21" x2="16" y2="21" /><line x1="12" y1="17" x2="12" y2="21" />
        </svg>
      </button>
      <a class="btn btn-ghost login" href={`${APP_URL}/login`}>{t('nav.login')}</a>
      <a class="btn btn-ghost demo-cta" href={`${DEMO_URL}/try`} target="_blank" rel="noopener">
        <i data-lucide="play-circle"></i> <span class="demo-cta-label">{t('nav.liveDemo')}</span>
      </a>
      <button class="btn btn-primary" type="button" data-early-access data-ea-source="nav">{t('nav.cta')}</button>
    </div>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in oklch, var(--background) 82%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .nav { display: flex; align-items: center; height: 64px; gap: 28px; }
  .brand { display: inline-flex; align-items: center; }
  .nav-links { display: flex; gap: 26px; margin-left: 8px; }
  .nav-links a { font-size: 14px; font-weight: 500; color: var(--muted-foreground); }
  .nav-links a:hover { color: var(--foreground); }
  .nav-right { margin-left: auto; display: flex; align-items: center; gap: 14px; }

  /* "Live demo" dropdown (hover/focus, desktop only) */
  .nav-dropdown { position: relative; display: inline-flex; align-items: center; }
  .nav-dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 14px;
    font-weight: 500;
    font-family: inherit;
    color: var(--muted-foreground);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }
  .nav-dropdown-trigger:hover { color: var(--foreground); }
  .nav-dropdown-trigger :global(svg) { width: 14px; height: 14px; transition: transform 0.15s ease; }
  .nav-dropdown:hover .nav-dropdown-trigger :global(svg),
  .nav-dropdown:focus-within .nav-dropdown-trigger :global(svg) { transform: rotate(180deg); }

  .nav-dropdown-menu {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    min-width: 200px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: 6px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
    z-index: 30;
  }
  /* Invisible bridge so the menu stays open while the cursor crosses the gap */
  .nav-dropdown-menu::before { content: ''; position: absolute; left: 0; right: 0; top: -10px; height: 10px; }
  .nav-dropdown:hover .nav-dropdown-menu,
  .nav-dropdown:focus-within .nav-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }
  .nav-dropdown-menu a {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--foreground);
    white-space: nowrap;
  }
  .nav-dropdown-menu a:hover { background: var(--purple-50); color: var(--primary); }
  .nav-dropdown-menu .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--chip-accent, var(--primary));
    box-shadow: 0 0 6px var(--chip-accent, var(--primary));
    flex-shrink: 0;
  }

  .theme-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--muted-foreground);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
    padding: 0;
  }
  .theme-btn:hover { border-color: var(--primary); color: var(--primary); }
  .theme-btn svg { display: block; }

  /* "Live demo" secondary button — stays visible (even on mobile) so the demo is
     always one click away. Outlined to read as secondary next to the primary CTA. */
  .demo-cta { gap: 6px; border: 1px solid var(--border); }
  .demo-cta:hover { border-color: var(--primary); color: var(--primary); }
  .demo-cta :global(svg) { width: 16px; height: 16px; display: inline-block; }

  @media (max-width: 860px) {
    .nav-links { display: none; }
    .login { display: none; }
  }
  /* On the tightest screens, collapse the demo button to its icon to save room. */
  @media (max-width: 520px) {
    .demo-cta-label { display: none; }
  }
</style>

<script>
  (function () {
    const root = document.documentElement;
    const order = ['light', 'dark', 'system'] as const;
    type Mode = (typeof order)[number];
    const icons: Record<Mode, HTMLElement | null> = {
      light: document.getElementById('icon-sun'),
      dark: document.getElementById('icon-moon'),
      system: document.getElementById('icon-system'),
    };
    const mq = window.matchMedia('(prefers-color-scheme: dark)');

    function getMode(): Mode {
      const s = localStorage.getItem('theme');
      return s === 'light' || s === 'dark' ? s : 'system';
    }

    function apply(mode: Mode) {
      const resolved = mode === 'system' ? (mq.matches ? 'dark' : 'light') : mode;
      root.setAttribute('data-theme', resolved);
      if (mode === 'system') localStorage.removeItem('theme');
      else localStorage.setItem('theme', mode);
    }

    function syncIcon(mode: Mode) {
      for (const k of order) {
        const el = icons[k];
        if (el) el.style.display = k === mode ? 'block' : 'none';
      }
    }

    // BaseLayout's inline script already painted data-theme; just reflect the mode.
    syncIcon(getMode());

    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const next = order[(order.indexOf(getMode()) + 1) % order.length];
      apply(next);
      syncIcon(next);
    });

    // Follow OS changes live while in system mode.
    mq.addEventListener('change', () => {
      if (getMode() === 'system') {
        apply('system');
        syncIcon('system');
      }
    });
  })();
</script>
