---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Nav from '~/components/Nav.astro';
import Hero from '~/components/Hero.astro';
import HeroShot from '~/components/HeroShot.astro';
import FoundingClubs from '~/components/FoundingClubs.astro';
import HeroFeatures from '~/components/HeroFeatures.astro';
import ProductShowcase from '~/components/ProductShowcase.astro';
import Payments from '~/components/Payments.astro';
import Migration from '~/components/Migration.astro';
import Features from '~/components/Features.astro';
import Pricing from '~/components/Pricing.astro';
import FounderNote from '~/components/FounderNote.astro';
import CTA from '~/components/CTA.astro';
import Footer from '~/components/Footer.astro';
import EarlyAccessModal from '~/components/EarlyAccessModal.astro';
import { defaultLang, useTranslations } from '~/i18n';

// Root page = default locale (English). Other locales are served from
// /[lang]/index.astro via getStaticPaths. Both share the same components.
const lang = defaultLang;
const t = useTranslations(lang);
---

<BaseLayout
  title={`${t('site.name')} — ${t('hero.tagline')}`}
  description={t('site.description')}
  lang={lang}
>
  <Nav lang={lang} />
  <main>
    <Hero lang={lang} />
    <HeroShot lang={lang} />
    <HeroFeatures lang={lang} />
    <ProductShowcase lang={lang} />
    <FoundingClubs lang={lang} />
    <Payments lang={lang} />
    <Pricing lang={lang} />
    <Migration lang={lang} />
    <Features lang={lang} />
    <FounderNote lang={lang} />
    <CTA lang={lang} />
  </main>
  <Footer lang={lang} />
  <EarlyAccessModal lang={lang} />
</BaseLayout>
