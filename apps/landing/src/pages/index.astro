---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Logo from '~/components/Logo.astro';

const FIREBASE_PROJECT_ID = import.meta.env.PUBLIC_FIREBASE_PROJECT_ID ?? 'demo-linyup';
const FIREBASE_API_KEY    = import.meta.env.PUBLIC_FIREBASE_API_KEY ?? '';
---

<BaseLayout
  title="Linyup — Coming soon"
  description="The all-in-one management tool for coaches and clubs. Launching soon."
  lang="en"
>
  <main class="prelaunch">
    <!-- Background orbs -->
    <div class="orb orb-1" aria-hidden="true"></div>
    <div class="orb orb-2" aria-hidden="true"></div>
    <div class="orb orb-3" aria-hidden="true"></div>

    <div class="content">
      <div class="logo-wrap">
        <Logo size={52} dark={true} />
      </div>

      <span class="badge">
        <span class="badge-dot"></span>
        Coming soon
      </span>

      <h1>
        Run your classes.<br />
        Know your students.<br />
        Grow your club.
      </h1>

      <p class="sub">
        Linyup is the all-in-one management tool for coaches and clubs —
        sessions, contacts, bookings, and a student mobile app, all in one place.
      </p>

      <form class="cta-form" id="early-access-form" novalidate>
        <input
          class="email-input"
          type="email"
          id="email-input"
          name="email"
          placeholder="Your email address"
          autocomplete="email"
          required
        />
        <button class="btn-cta" type="submit" id="submit-btn">
          Get early access
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </button>
      </form>

      <p class="form-status" id="form-status" aria-live="polite"></p>
    </div>
  </main>
</BaseLayout>

<script define:vars={{ FIREBASE_PROJECT_ID, FIREBASE_API_KEY }}>
  const form = document.getElementById('early-access-form');
  const input = document.getElementById('email-input');
  const btn = document.getElementById('submit-btn');
  const status = document.getElementById('form-status');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = input.value.trim();
    if (!email) return;

    btn.disabled = true;
    btn.textContent = 'Sending…';
    status.textContent = '';
    status.className = 'form-status';

    try {
      const url = FIREBASE_PROJECT_ID === 'demo-linyup'
        ? `http://localhost:8080/v1/projects/${FIREBASE_PROJECT_ID}/databases/(default)/documents/early_access_requests`
        : `https://firestore.googleapis.com/v1/projects/${FIREBASE_PROJECT_ID}/databases/(default)/documents/early_access_requests?key=${FIREBASE_API_KEY}`;

      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          fields: {
            email:     { stringValue: email },
            createdAt: { timestampValue: new Date().toISOString() },
            source:    { stringValue: 'landing' },
          },
        }),
      });

      if (!res.ok) {
        const body = await res.json().catch(() => ({}));
        // Duplicate emails are fine — treat as success
        if (res.status === 409) {
          showSuccess();
        } else {
          throw new Error(body?.error?.message ?? `HTTP ${res.status}`);
        }
      } else {
        showSuccess();
      }
    } catch (err) {
      console.error('Early access submit error:', err);
      status.textContent = 'Something went wrong — please try again.';
      status.className = 'form-status error';
      btn.disabled = false;
      btn.innerHTML = 'Get early access <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>';
    }
  });

  function showSuccess() {
    form.style.display = 'none';
    status.textContent = "You're on the list! We'll be in touch soon.";
    status.className = 'form-status success';
  }
</script>

<style>
  .prelaunch {
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(160deg,
        oklch(0.10 0.05 280) 0%,
        oklch(0.14 0.10 292) 45%,
        oklch(0.11 0.07 305) 100%);
  }

  /* Glow orbs */
  .orb {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(80px);
    opacity: 0.55;
  }
  .orb-1 {
    width: 700px; height: 500px;
    top: -160px; left: 50%;
    transform: translateX(-50%);
    background: radial-gradient(ellipse, oklch(0.48 0.28 292 / 0.7), transparent 70%);
    opacity: 0.45;
  }
  .orb-2 {
    width: 400px; height: 400px;
    bottom: -100px; right: -80px;
    background: radial-gradient(ellipse, oklch(0.42 0.22 315 / 0.6), transparent 70%);
  }
  .orb-3 {
    width: 300px; height: 300px;
    bottom: 10%; left: -60px;
    background: radial-gradient(ellipse, oklch(0.40 0.20 270 / 0.5), transparent 70%);
    opacity: 0.40;
  }

  .content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 40px 24px;
    max-width: 680px;
  }

  .logo-wrap {
    margin-bottom: 32px;
  }

  /* Coming soon badge */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: oklch(0.82 0.12 292);
    background: oklch(0.48 0.22 292 / 0.20);
    border: 1px solid oklch(0.60 0.20 292 / 0.35);
    padding: 5px 14px;
    border-radius: 9999px;
    margin-bottom: 28px;
    backdrop-filter: blur(8px);
  }
  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: oklch(0.72 0.20 292);
    box-shadow: 0 0 8px oklch(0.72 0.20 292 / 0.8);
    animation: pulse 2.4s ease-in-out infinite;
  }

  h1 {
    font-family: "Anton", var(--font-sans);
    font-weight: 400;
    font-size: clamp(42px, 8vw, 72px);
    line-height: 1.0;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0 0 24px;
    text-wrap: balance;
  }

  .sub {
    font-size: clamp(16px, 2.2vw, 18px);
    line-height: 1.65;
    color: oklch(0.80 0.04 288);
    margin: 0 0 40px;
    max-width: 52ch;
    text-wrap: pretty;
  }

  .cta-form {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    max-width: 480px;
  }

  .email-input {
    flex: 1;
    height: 52px;
    padding: 0 18px;
    border-radius: 10px;
    font-size: 15px;
    font-family: inherit;
    background: oklch(1 0 0 / 0.08);
    border: 1px solid oklch(1 0 0 / 0.18);
    color: #fff;
    outline: none;
    transition: border-color 0.18s ease, background 0.18s ease;
    backdrop-filter: blur(8px);
  }
  .email-input::placeholder {
    color: oklch(0.70 0.04 288);
  }
  .email-input:focus {
    border-color: oklch(0.62 0.22 292 / 0.8);
    background: oklch(1 0 0 / 0.12);
  }

  .btn-cta {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 52px;
    padding: 0 24px;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 700;
    font-family: inherit;
    background: oklch(0.62 0.22 292);
    color: #fff;
    border: 1px solid oklch(0.70 0.22 292 / 0.5);
    box-shadow: 0 0 28px oklch(0.62 0.22 292 / 0.45), 0 2px 8px oklch(0 0 0 / 0.3);
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.18s ease;
  }
  .btn-cta:hover:not(:disabled) {
    background: oklch(0.68 0.22 292);
    box-shadow: 0 0 40px oklch(0.62 0.22 292 / 0.60), 0 4px 16px oklch(0 0 0 / 0.3);
    transform: translateY(-1px);
  }
  .btn-cta:active:not(:disabled) {
    transform: translateY(0);
  }
  .btn-cta:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .btn-cta svg {
    transition: transform 0.18s ease;
    flex-shrink: 0;
  }
  .btn-cta:hover:not(:disabled) svg {
    transform: translateX(3px);
  }

  .form-status {
    margin-top: 16px;
    font-size: 14px;
    min-height: 20px;
    color: oklch(0.80 0.04 288);
  }
  .form-status.success {
    color: oklch(0.78 0.18 152);
  }
  .form-status.error {
    color: oklch(0.72 0.20 25);
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.85); }
  }

  @media (max-width: 540px) {
    h1 { font-size: 38px; }
    .cta-form { flex-direction: column; }
    .email-input, .btn-cta { width: 100%; justify-content: center; }
  }
</style>
