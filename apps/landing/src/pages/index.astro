---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Logo from '~/components/Logo.astro';

const FIREBASE_PROJECT_ID = import.meta.env.PUBLIC_FIREBASE_PROJECT_ID ?? 'demo-linyup';
const FIREBASE_API_KEY    = import.meta.env.PUBLIC_FIREBASE_API_KEY ?? '';

// Live demo playground (sandbox env). Each chip links straight to /preview?team=,
// which auto-signs into that demo team and lands on the dashboard. Keep the keys
// and labels in sync with DEMO_ACCOUNTS in apps/web/src/lib/demo.ts.
const DEMO_URL = import.meta.env.PUBLIC_DEMO_URL ?? 'https://demo.linyup.com';
const DEMO_STUDIOS = [
  { key: 'grappling', label: 'Martial arts', accent: '#dc2626' },
  { key: 'crossfit',  label: 'CrossFit',     accent: '#0f172a' },
  { key: 'tennis',    label: 'Tennis',       accent: '#16a34a' },
  { key: 'yoga',      label: 'Yoga',         accent: '#9333ea' },
  { key: 'pilates',   label: 'Pilates',      accent: '#0d9488' },
  { key: 'dance',     label: 'Dance',        accent: '#db2777' },
];
---

<BaseLayout
  title="Linyup — Coming soon"
  description="The all-in-one management tool for coaches and studios. Launching soon."
  lang="en"
>
  <main class="prelaunch">
    <!-- Background orbs -->
    <div class="orb orb-1" aria-hidden="true"></div>
    <div class="orb orb-2" aria-hidden="true"></div>
    <div class="orb orb-3" aria-hidden="true"></div>

    <!-- ── Hero ─────────────────────────────────────────────────────── -->
    <section class="hero">
      <div class="logo-wrap">
        <Logo size={52} dark={true} />
      </div>

      <span class="badge">
        <span class="badge-dot"></span>
        Coming soon
      </span>

      <h1>
        Run your classes.<br />
        Know your students.<br />
        Grow your studio.
      </h1>

      <p class="sub">
        Linyup is the all-in-one management tool for coaches and studios.
        Sessions, contacts, bookings, and a student mobile app, all in one place.
      </p>

      <form class="cta-form" id="early-access-form" novalidate>
        <input
          class="email-input"
          type="email"
          id="email-input"
          name="email"
          placeholder="Your email address"
          autocomplete="email"
          required
        />
        <button class="btn-cta" type="submit" id="submit-btn">
          Get early access
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </button>
      </form>

      <p class="form-status" id="form-status" aria-live="polite"></p>

      <p class="price-nudge">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        Priced for real coaches and studios. Plans you will love.
      </p>
    </section>

    <!-- ── Try the demo (direct, pick by type) ───────────────────────── -->
    <section class="demo-cta">
      <p class="demo-eyebrow">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 3 14 9-14 9V3z"/></svg>
        No signup — explore a live demo
      </p>
      <h2 class="demo-title">Pick the type closest to yours and jump straight in</h2>

      <div class="demo-chips">
        {DEMO_STUDIOS.map((studio) => (
          <a
            class="demo-chip"
            href={`${DEMO_URL}/preview?team=${studio.key}`}
            target="_blank"
            rel="noopener"
            style={`--chip-accent: ${studio.accent}`}
          >
            <span class="demo-chip-dot"></span>
            {studio.label}
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        ))}
      </div>
    </section>

    <!-- ── Feature highlights ────────────────────────────────────────── -->
    <section class="features">
      <div class="feature">
        <div class="ficon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01"/></svg>
        </div>
        <div class="ftext">
          <h3>Sessions & scheduling</h3>
          <p>Recurring classes, attendance tracking, and a full calendar view. Your whole week at a glance.</p>
        </div>
      </div>

      <div class="feature">
        <div class="ficon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div class="ftext">
          <h3>Contacts & memberships</h3>
          <p>Every student's profile, notes, activity history, and subscription status. All in one place.</p>
        </div>
      </div>

      <div class="feature">
        <div class="ficon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/></svg>
        </div>
        <div class="ftext">
          <h3>Student mobile app</h3>
          <p>Students book sessions and check in on iOS and Android. No more WhatsApp chaos.</p>
        </div>
      </div>
    </section>

    <!-- ── Footer note ───────────────────────────────────────────────── -->
    <footer class="pre-footer">
      <p>© 2025 Linyup · All rights reserved</p>
    </footer>
  </main>
</BaseLayout>

<script define:vars={{ FIREBASE_PROJECT_ID, FIREBASE_API_KEY }}>
  const form = document.getElementById('early-access-form');
  const input = document.getElementById('email-input');
  const btn = document.getElementById('submit-btn');
  const status = document.getElementById('form-status');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = input.value.trim();
    if (!email) return;

    btn.disabled = true;
    btn.textContent = 'Sending…';
    status.textContent = '';
    status.className = 'form-status';

    try {
      const url = FIREBASE_PROJECT_ID === 'demo-linyup'
        ? `http://localhost:8080/v1/projects/${FIREBASE_PROJECT_ID}/databases/(default)/documents/early_access_requests`
        : `https://firestore.googleapis.com/v1/projects/${FIREBASE_PROJECT_ID}/databases/(default)/documents/early_access_requests?key=${FIREBASE_API_KEY}`;

      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          fields: {
            email:     { stringValue: email },
            createdAt: { timestampValue: new Date().toISOString() },
            source:    { stringValue: 'landing' },
          },
        }),
      });

      if (!res.ok) {
        const body = await res.json().catch(() => ({}));
        if (res.status === 409) {
          showSuccess();
        } else {
          throw new Error(body?.error?.message ?? `HTTP ${res.status}`);
        }
      } else {
        showSuccess();
      }
    } catch (err) {
      console.error('Early access submit error:', err);
      status.textContent = 'Something went wrong — please try again.';
      status.className = 'form-status error';
      btn.disabled = false;
      btn.innerHTML = 'Get early access <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>';
    }
  });

  function showSuccess() {
    form.style.display = 'none';
    status.textContent = "You're on the list! We'll be in touch soon.";
    status.className = 'form-status success';
  }
</script>

<style>
  /* ── Base ───────────────────────────────────────────────────────────── */
  .prelaunch {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    overflow-x: hidden;
    background:
      linear-gradient(160deg,
        oklch(0.10 0.05 280) 0%,
        oklch(0.14 0.10 292) 45%,
        oklch(0.11 0.07 305) 100%);
  }

  /* ── Orbs ───────────────────────────────────────────────────────────── */
  .orb {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(80px);
  }
  .orb-1 {
    width: 700px; height: 500px;
    top: -160px; left: 50%;
    transform: translateX(-50%);
    background: radial-gradient(ellipse, oklch(0.48 0.28 292 / 0.7), transparent 70%);
    opacity: 0.45;
  }
  .orb-2 {
    width: 400px; height: 400px;
    bottom: 30%; right: -80px;
    background: radial-gradient(ellipse, oklch(0.42 0.22 315 / 0.6), transparent 70%);
    opacity: 0.55;
  }
  .orb-3 {
    width: 300px; height: 300px;
    bottom: 20%; left: -60px;
    background: radial-gradient(ellipse, oklch(0.40 0.20 270 / 0.5), transparent 70%);
    opacity: 0.40;
  }

  /* ── Hero ───────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 120px 24px 96px;
    max-width: 680px;
    width: 100%;
  }

  .logo-wrap { margin-bottom: 48px; }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: oklch(0.82 0.12 292);
    background: oklch(0.48 0.22 292 / 0.20);
    border: 1px solid oklch(0.60 0.20 292 / 0.35);
    padding: 5px 14px;
    border-radius: 9999px;
    margin-bottom: 40px;
    backdrop-filter: blur(8px);
  }
  .badge-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: oklch(0.72 0.20 292);
    box-shadow: 0 0 8px oklch(0.72 0.20 292 / 0.8);
    animation: pulse 2.4s ease-in-out infinite;
  }

  h1 {
    font-family: "Anton", var(--font-sans);
    font-weight: 400;
    font-size: clamp(42px, 8vw, 72px);
    line-height: 1.0;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0 0 24px;
    text-wrap: balance;
  }

  .sub {
    font-size: clamp(16px, 2.2vw, 18px);
    line-height: 1.65;
    color: oklch(0.80 0.04 288);
    margin: 0 0 40px;
    max-width: 52ch;
    text-wrap: pretty;
  }

  .cta-form {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    max-width: 480px;
  }

  .email-input {
    flex: 1;
    height: 52px;
    padding: 0 18px;
    border-radius: 10px;
    font-size: 15px;
    font-family: inherit;
    background: oklch(1 0 0 / 0.08);
    border: 1px solid oklch(1 0 0 / 0.18);
    color: #fff;
    outline: none;
    transition: border-color 0.18s ease, background 0.18s ease;
    backdrop-filter: blur(8px);
  }
  .email-input::placeholder { color: oklch(0.70 0.04 288); }
  .email-input:focus {
    border-color: oklch(0.62 0.22 292 / 0.8);
    background: oklch(1 0 0 / 0.12);
  }

  .btn-cta {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 52px;
    padding: 0 24px;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 700;
    font-family: inherit;
    background: oklch(0.62 0.22 292);
    color: #fff;
    border: 1px solid oklch(0.70 0.22 292 / 0.5);
    box-shadow: 0 0 28px oklch(0.62 0.22 292 / 0.45), 0 2px 8px oklch(0 0 0 / 0.3);
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.18s ease;
  }
  .btn-cta:hover:not(:disabled) {
    background: oklch(0.68 0.22 292);
    box-shadow: 0 0 40px oklch(0.62 0.22 292 / 0.60), 0 4px 16px oklch(0 0 0 / 0.3);
    transform: translateY(-1px);
  }
  .btn-cta:active:not(:disabled) { transform: translateY(0); }
  .btn-cta:disabled { opacity: 0.6; cursor: not-allowed; }
  .btn-cta svg { transition: transform 0.18s ease; flex-shrink: 0; }
  .btn-cta:hover:not(:disabled) svg { transform: translateX(3px); }

  .form-status {
    margin-top: 16px;
    font-size: 14px;
    min-height: 20px;
    color: oklch(0.80 0.04 288);
  }
  .form-status.success { color: oklch(0.78 0.18 152); }
  .form-status.error   { color: oklch(0.72 0.20 25); }

  .price-nudge {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-top: 24px;
    font-size: 14px;
    font-weight: 500;
    color: oklch(0.82 0.10 292);
  }
  .price-nudge svg { flex-shrink: 0; color: oklch(0.72 0.22 292); }

  /* ── Features ───────────────────────────────────────────────────────── */
  .features {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    width: 100%;
    max-width: 900px;
    padding: 0 24px 96px;
  }

  .feature {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    background: oklch(1 0 0 / 0.05);
    border: 1px solid oklch(1 0 0 / 0.10);
    border-radius: 16px;
    padding: 24px;
    backdrop-filter: blur(12px);
    transition: background 0.2s;
  }
  .feature:hover { background: oklch(1 0 0 / 0.08); }

  .ficon {
    flex-shrink: 0;
    width: 44px; height: 44px;
    border-radius: 10px;
    background: oklch(0.48 0.22 292 / 0.25);
    border: 1px solid oklch(0.60 0.20 292 / 0.30);
    display: flex;
    align-items: center;
    justify-content: center;
    color: oklch(0.78 0.18 292);
  }

  .ftext h3 {
    font-size: 14px;
    font-weight: 700;
    color: #fff;
    margin: 0 0 6px;
    letter-spacing: 0.01em;
  }
  .ftext p {
    font-size: 13px;
    line-height: 1.6;
    color: oklch(0.72 0.05 288);
    margin: 0;
  }

  /* ── Try the demo (type chips) ──────────────────────────────────────── */
  .demo-cta {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    max-width: 720px;
    padding: 0 24px 96px;
  }

  .demo-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: oklch(0.72 0.14 292);
    margin: 0 0 14px;
  }
  .demo-eyebrow svg { color: oklch(0.72 0.22 292); }

  .demo-title {
    font-size: clamp(20px, 3vw, 26px);
    font-weight: 700;
    line-height: 1.3;
    color: #fff;
    margin: 0 0 28px;
    text-wrap: balance;
  }

  .demo-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    width: 100%;
  }

  .demo-chip {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 15px;
    font-weight: 600;
    color: #fff;
    text-decoration: none;
    background: oklch(1 0 0 / 0.06);
    border: 1px solid oklch(1 0 0 / 0.14);
    border-radius: 9999px;
    padding: 11px 20px;
    backdrop-filter: blur(8px);
    transition: background 0.16s ease, border-color 0.16s ease, transform 0.16s ease;
  }
  .demo-chip:hover {
    background: oklch(1 0 0 / 0.12);
    border-color: oklch(0.62 0.18 292 / 0.55);
    transform: translateY(-2px);
  }
  .demo-chip-dot {
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--chip-accent, oklch(0.72 0.20 292));
    box-shadow: 0 0 8px var(--chip-accent, oklch(0.72 0.20 292));
    flex-shrink: 0;
  }
  .demo-chip svg {
    color: oklch(0.70 0.06 288);
    transition: transform 0.16s ease, color 0.16s ease;
    flex-shrink: 0;
  }
  .demo-chip:hover svg {
    color: #fff;
    transform: translateX(3px);
  }

  /* ── Footer ─────────────────────────────────────────────────────────── */
  .pre-footer {
    position: relative;
    z-index: 1;
    padding: 0 24px 32px;
    font-size: 12px;
    color: oklch(0.45 0.04 288);
    text-align: center;
  }

  /* ── Animations ─────────────────────────────────────────────────────── */
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.5; transform: scale(0.85); }
  }

  /* ── Responsive ─────────────────────────────────────────────────────── */
  @media (max-width: 720px) {
    .features { grid-template-columns: 1fr; }
  }

  @media (max-width: 540px) {
    h1 { font-size: 38px; }
    .cta-form { flex-direction: column; }
    .email-input, .btn-cta { width: 100%; justify-content: center; }
  }
</style>
