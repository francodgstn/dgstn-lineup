---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
// Copy is verbatim from the product's i18n (apps/landing/src/i18n/locales/en.json),
// with the wordmark rendered as the new "linyup" lockup. To re-enable i18n, swap the
// hardcoded strings for t('hero.title') etc. via your existing src/i18n helper.
---
<Layout>
  <header>
    <div class="wrap nav">
      <Logo size={22} />
      <nav class="nav-links">
        <a href="#features">Features</a>
        <a href="#pricing">Pricing</a>
      </nav>
      <div class="nav-right">
        <a class="btn btn-ghost" href="#">Log in</a>
        <a class="btn btn-primary" href="#">Start free</a>
      </div>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="wrap">
        <span class="eyebrow"><i data-lucide="zap"></i> For coaches, gyms, and clubs</span>
        <h1 class="title">Run your classes.<br />Know your students.<br />Grow your club.</h1>
        <p class="sub">linyup is the all-in-one management tool for coaches and clubs — sessions, contacts, bookings, and a student mobile app, all in one place.</p>
        <div class="hero-cta">
          <a class="btn btn-primary btn-lg" href="#">Start for free <i data-lucide="arrow-right"></i></a>
          <a class="btn btn-outline btn-lg" href="#features">See features</a>
        </div>

        <div class="shot">
          <div class="shot-bar">
            <span class="dotr" style="background:#f87171"></span>
            <span class="dotr" style="background:#fbbf24"></span>
            <span class="dotr" style="background:#34d399"></span>
            <div class="shot-logo"><Logo size={15} /></div>
          </div>
          <div class="shot-body">
            <div class="shot-sb">
              <div class="shot-nl on"><i data-lucide="layout-dashboard"></i> Dashboard</div>
              <div class="shot-nl"><i data-lucide="calendar"></i> Calendar</div>
              <div class="shot-nl"><i data-lucide="users"></i> Contacts</div>
              <div class="shot-nl"><i data-lucide="clipboard-list"></i> Bookings</div>
              <div class="shot-nl"><i data-lucide="trophy"></i> Gamification</div>
            </div>
            <div class="shot-main">
              <div class="shot-stats">
                <div class="shot-stat"><div class="lab">Active members</div><div class="num">248</div></div>
                <div class="shot-stat"><div class="lab">Engaged / wk</div><div class="num">34</div></div>
                <div class="shot-stat"><div class="lab">Bookings</div><div class="num">60</div></div>
              </div>
              <div class="shot-card">
                <div class="shot-row"><div class="shot-av">MS</div><div class="shot-name">Mara Schneider</div><span class="pill ok">Active</span></div>
                <div class="shot-row"><div class="shot-av">JD</div><div class="shot-name">Jonas Diaz</div><span class="pill tr">Trial</span></div>
                <div class="shot-row"><div class="shot-av">AR</div><div class="shot-name">Aïsha Rahimi</div><span class="pill ok">Active</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="features">
      <div class="wrap">
        <div class="sec-head">
          <h2>Everything you need to run a modern club</h2>
          <p>From solo coach to multi-location organisation, linyup adapts to the way you work.</p>
        </div>
        <div class="features">
          <div class="feature">
            <div class="ficon"><i data-lucide="calendar-range"></i></div>
            <h3>Sessions</h3>
            <p>Schedule and track classes effortlessly. Set recurring sessions, manage attendance, and see your whole week at a glance in the calendar view.</p>
          </div>
          <div class="feature">
            <div class="ficon"><i data-lucide="users"></i></div>
            <h3>Contacts</h3>
            <p>Know every student. Profile pages, notes, activity history, and subscription status — everything you need to build lasting relationships.</p>
          </div>
          <div class="feature">
            <div class="ficon"><i data-lucide="smartphone"></i></div>
            <h3>Student mobile app</h3>
            <p>Students book sessions, check in, and stay connected on iOS and Android. No more WhatsApp chaos.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="pricing" class="plans-sec">
      <div class="wrap">
        <div class="sec-head">
          <h2>Plans for every stage</h2>
          <p>Pricing details coming soon. Join early access and be the first to know.</p>
        </div>
        <div class="plans">
          <div class="plan">
            <h3>Coach</h3>
            <p class="aud">For solo instructors and private coaches.</p>
            <ul class="feat-list">
              <li><i data-lucide="check"></i> Sessions &amp; attendance</li>
              <li><i data-lucide="check"></i> Up to 50 contacts</li>
              <li><i data-lucide="check"></i> Student mobile app</li>
            </ul>
            <div class="price">Pricing coming soon</div>
            <a class="btn btn-outline btn-block" href="#">Join early access</a>
          </div>
          <div class="plan featured">
            <span class="plan-tag">Most popular</span>
            <h3>Club</h3>
            <p class="aud">For gyms and clubs with multiple coaches and classes.</p>
            <ul class="feat-list">
              <li><i data-lucide="check"></i> Everything in Coach</li>
              <li><i data-lucide="check"></i> Unlimited contacts</li>
              <li><i data-lucide="check"></i> Automations &amp; gamification</li>
              <li><i data-lucide="check"></i> Trends &amp; analytics</li>
            </ul>
            <div class="price">Pricing coming soon</div>
            <a class="btn btn-primary btn-block" href="#">Join early access</a>
          </div>
          <div class="plan">
            <h3>Organisation</h3>
            <p class="aud">For multi-location clubs, federations, and franchises.</p>
            <ul class="feat-list">
              <li><i data-lucide="check"></i> Everything in Club</li>
              <li><i data-lucide="check"></i> Multi-club hierarchy</li>
              <li><i data-lucide="check"></i> Org-wide rankings &amp; events</li>
            </ul>
            <div class="price">Pricing coming soon</div>
            <a class="btn btn-outline btn-block" href="#">Join early access</a>
          </div>
        </div>
        <p class="early-note">Free during early access. No credit card required.</p>
      </div>
    </section>

    <section class="cta-band">
      <div class="wrap">
        <div class="cta-inner">
          <h2>Ready to get started?</h2>
          <p>Join coaches and clubs already using linyup to run their business.</p>
          <a class="btn btn-white btn-lg" href="#">Start for free <i data-lucide="arrow-right"></i></a>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap">
      <div class="foot">
        <Logo size={18} />
        <span class="tag">The modern management tool for coaches and clubs.</span>
        <div class="foot-links">
          <a href="#">Privacy</a>
          <a href="#">Terms</a>
          <a href="#">Contact</a>
        </div>
      </div>
      <div class="copy">© 2026 linyup. All rights reserved.</div>
    </div>
  </footer>

  <script is:inline src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
  <script is:inline>lucide.createIcons();</script>
</Layout>

<style>
  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px; }
  svg { display: block; }
  i[data-lucide] { display: inline-flex; }

  header { position: sticky; top: 0; z-index: 20; background: color-mix(in oklch, var(--background) 82%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--border); }
  .nav { display: flex; align-items: center; height: 64px; gap: 28px; }
  .nav-links { display: flex; gap: 26px; margin-left: 8px; }
  .nav-links a { font-size: 14px; font-weight: 500; color: var(--muted-foreground); }
  .nav-links a:hover { color: var(--foreground); }
  .nav-right { margin-left: auto; display: flex; align-items: center; gap: 14px; }

  .btn { display: inline-flex; align-items: center; gap: 8px; height: 40px; padding: 0 18px; border-radius: var(--radius-lg); font-size: 14px; font-weight: 600; cursor: pointer; border: 1px solid transparent; transition: all .15s; font-family: inherit; }
  .btn :global(svg) { width: 17px; height: 17px; }
  .btn-primary { background: var(--primary); color: #fff; }
  .btn-primary:hover { background: var(--primary-hover); }
  .btn-primary:active { transform: translateY(1px); }
  .btn-ghost { color: var(--foreground); }
  .btn-ghost:hover { color: var(--primary); }
  .btn-outline { border-color: var(--border); background: var(--card); }
  .btn-outline:hover { background: var(--purple-50); }
  .btn-lg { height: 48px; padding: 0 24px; font-size: 15px; }
  .btn-block { justify-content: center; }

  .hero { padding: 88px 0 64px; text-align: center; }
  .eyebrow { display: inline-flex; align-items: center; gap: 7px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--purple-700); background: var(--purple-50); border: 1px solid var(--purple-200); padding: 5px 12px; border-radius: var(--radius-pill); }
  .eyebrow :global(svg) { width: 13px; height: 13px; }
  h1.title { font-family: "Anton", var(--font-sans); font-weight: 400; font-size: 66px; line-height: 0.98; letter-spacing: 0.005em; text-transform: uppercase; margin: 22px auto 0; text-wrap: balance; }
  .sub { font-size: 19px; line-height: 1.55; color: var(--muted-foreground); max-width: 60ch; margin: 22px auto 0; text-wrap: pretty; }
  .hero-cta { display: flex; gap: 12px; justify-content: center; margin-top: 30px; }

  .shot { margin: 56px auto 0; max-width: 980px; border-radius: 16px; background: var(--card); box-shadow: var(--shadow-lg), var(--ring-card); overflow: hidden; text-align: left; }
  .shot-bar { height: 40px; display: flex; align-items: center; gap: 7px; padding: 0 14px; border-bottom: 1px solid var(--border); background: var(--sidebar); }
  .shot-logo { margin-left: 12px; }
  .dotr { width: 11px; height: 11px; border-radius: 50%; }
  .shot-body { display: flex; height: 340px; }
  .shot-sb { width: 190px; background: var(--sidebar); border-right: 1px solid var(--border); padding: 14px 10px; }
  .shot-nl { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: 8px; font-size: 13px; font-weight: 500; color: var(--muted-foreground); }
  .shot-nl :global(svg) { width: 15px; height: 15px; }
  .shot-nl.on { background: color-mix(in oklch, var(--primary) 10%, transparent); color: var(--primary); font-weight: 600; box-shadow: inset 3px 0 0 var(--primary); }
  .shot-main { flex: 1; padding: 20px; background: var(--background); }
  .shot-stats { display: grid; grid-template-columns: repeat(3,1fr); gap: 12px; }
  .shot-stat { background: var(--card); border-radius: 12px; box-shadow: var(--ring-card), var(--shadow-sm); border-left: 4px solid var(--primary); padding: 14px; }
  .shot-stat .lab { font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted-foreground); }
  .shot-stat .num { font-size: 30px; font-weight: 800; margin-top: 6px; }
  .shot-card { margin-top: 14px; background: var(--card); border-radius: 12px; box-shadow: var(--ring-card), var(--shadow-sm); padding: 6px 14px; }
  .shot-row { display: flex; align-items: center; gap: 10px; padding: 8px 0; border-bottom: 1px solid color-mix(in oklch, var(--border) 60%, transparent); }
  .shot-row:last-child { border-bottom: 0; }
  .shot-name { font-size: 13px; font-weight: 500; }
  .shot-av { width: 28px; height: 28px; border-radius: 50%; background: var(--purple-100); color: var(--purple-700); display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 600; }
  .pill { font-size: 11px; font-weight: 500; padding: 2px 8px; border-radius: 99px; margin-left: auto; }
  .pill.ok { background: var(--success-bg); color: var(--success-fg); }
  .pill.tr { background: var(--warning-bg); color: var(--warning-fg); }

  section { padding: 80px 0; }
  .sec-head { text-align: center; max-width: 60ch; margin: 0 auto 48px; }
  .sec-head h2 { font-family: "Sora", var(--font-sans); font-weight: 700; font-size: 40px; letter-spacing: -0.01em; }
  .sec-head p { font-size: 17px; color: var(--muted-foreground); margin: 14px auto 0; }
  .features { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .feature { background: var(--card); border-radius: var(--radius-xl); box-shadow: var(--ring-card), var(--shadow-sm); padding: 28px; }
  .ficon { width: 48px; height: 48px; border-radius: 12px; background: var(--purple-50); color: var(--primary); display: flex; align-items: center; justify-content: center; border: 1px solid var(--purple-100); }
  .ficon :global(svg) { width: 24px; height: 24px; }
  .feature h3 { font-family: var(--font-display); font-weight: 600; font-size: 22px; margin: 18px 0 8px; }
  .feature p { font-size: 14.5px; line-height: 1.6; color: var(--muted-foreground); margin: 0; }

  .plans-sec { background: var(--purple-50); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .plan { background: var(--card); border-radius: var(--radius-xl); box-shadow: var(--ring-card), var(--shadow-sm); padding: 28px; display: flex; flex-direction: column; }
  .plan.featured { box-shadow: var(--shadow-lg); border: 2px solid var(--primary); position: relative; }
  .plan-tag { position: absolute; top: -11px; left: 28px; background: var(--primary); color: #fff; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; padding: 3px 10px; border-radius: 99px; }
  .plan h3 { font-family: var(--font-display); font-weight: 600; font-size: 26px; }
  .plan .aud { font-size: 14px; color: var(--muted-foreground); margin: 8px 0 18px; min-height: 42px; }
  .plan .price { font-family: var(--font-display); font-size: 17px; font-weight: 600; color: var(--muted-foreground); padding: 14px 0 18px; border-top: 1px solid var(--border); margin-top: auto; }
  .feat-list { list-style: none; padding: 0; margin: 0 0 18px; display: flex; flex-direction: column; gap: 9px; }
  .feat-list li { display: flex; align-items: center; gap: 9px; font-size: 13.5px; }
  .feat-list :global(svg) { width: 16px; height: 16px; color: var(--success-fg); flex-shrink: 0; }
  .early-note { text-align: center; font-size: 13px; color: var(--muted-foreground); margin-top: 24px; }

  .cta-band { text-align: center; }
  .cta-inner { background: var(--purple-900); color: #fff; border-radius: 24px; padding: 64px 32px; background-image: radial-gradient(circle at 80% 20%, var(--purple-700), transparent 60%); }
  .cta-inner h2 { font-family: "Sora", var(--font-sans); font-weight: 700; font-size: 40px; color: #fff; }
  .cta-inner p { font-size: 17px; opacity: 0.85; margin: 14px auto 28px; max-width: 50ch; }
  .btn-white { background: #fff; color: var(--purple-900); }
  .btn-white:hover { background: var(--purple-50); }

  footer { padding: 48px 0; border-top: 1px solid var(--border); }
  .foot { display: flex; align-items: center; gap: 16px; }
  .foot .tag { font-size: 13.5px; color: var(--muted-foreground); max-width: 36ch; }
  .foot-links { margin-left: auto; display: flex; gap: 22px; }
  .foot-links a { font-size: 13.5px; color: var(--muted-foreground); }
  .foot-links a:hover { color: var(--foreground); }
  .copy { font-size: 12.5px; color: var(--muted-foreground); margin-top: 22px; }

  @media (max-width: 860px) {
    h1.title { font-size: 40px; }
    .features, .plans { grid-template-columns: 1fr; }
    .nav-links { display: none; }
    .shot-body { height: auto; flex-direction: column; }
    .shot-sb { width: auto; display: flex; overflow-x: auto; }
  }
</style>
