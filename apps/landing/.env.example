# URL of the Linyup web app (used for "Start free" / "Log in" links)
PUBLIC_APP_URL=https://app.linyup.com

# Canonical base URL of this landing site (used for og:url etc.)
PUBLIC_SITE_URL=https://linyup.com

# URL of the sandbox demo playground (live "sneak peek" iframe + Open-the-demo
# links). Local dev: http://localhost:3000 with NEXT_PUBLIC_DEMO_MODE=true.
PUBLIC_DEMO_URL=https://demo.linyup.com

# PostHog product analytics. The public project key (phc_…) is safe to embed in
# the static bundle. Leave blank to disable analytics entirely (no script loads —
# the default for local dev). Host is PostHog EU cloud.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
