# ─── Local operator console → the CLOUD sandbox (linyup-sandbox) ─────────────
# Loaded by `pnpm dev:admin:sandbox` (node --env-file). Values set here OVERRIDE
# .env.local (process env beats dotenv files in Next.js), so the emulator vars
# from .env.local don't apply on this path.
#
# Requirements:
#   · gcloud auth application-default login   (Admin SDK uses ADC)
#   · your ADC identity needs Firestore/Auth access on linyup-sandbox
#   · sign in on /login with an OPERATOR_EMAILS account that exists in the
#     sandbox project's Firebase Auth
#
# COMMITTED: public web-app client config + project ids only — no secrets.

USE_FIREBASE_EMULATORS=false
FIREBASE_PROJECT_ID=linyup-sandbox
GOOGLE_CLOUD_PROJECT=linyup-sandbox

# Public client config of the linyup-sandbox web app (mirrors
# apps/web/apphosting.sandbox.yaml — regenerate from `terraform output
# firebase_web_config` if the project is ever recreated).
NEXT_PUBLIC_USE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyANE6K6TejYLR9I75O88SLotpnDullEGjw
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=linyup-sandbox.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=linyup-sandbox
NEXT_PUBLIC_FIREBASE_APP_ID=1:1006203712444:web:5f1a15e86998c7a42671b9

# Operator allowlist (break-glass path; the durable mechanism is the
# `saas_operator` custom claim on the user record).
OPERATOR_EMAILS=franco.dgstn@gmail.com
