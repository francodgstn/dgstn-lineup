# ─── Local development against the Firebase emulators ───────────────────────
# Point the Admin SDK at the running emulators (pnpm emulators:seed).
USE_FIREBASE_EMULATORS=true
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# Needed for feedback screenshots (streamed from Storage by the console).
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
FIREBASE_PROJECT_ID=demo-linyup
# Optional override; defaults to {projectId}.appspot.com on the emulator and
# {projectId}.firebasestorage.app on cloud projects.
# FIREBASE_STORAGE_BUCKET=demo-linyup.appspot.com

# Client Firebase config (login page only). For the emulator these can be the
# demo placeholders used by apps/web.
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-linyup.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-linyup
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id

# Operator allowlist (comma-separated). Overrides the built-in default.
# In demo mode the seeded owners (coach@/club@/org@linyup.com) are allowed too.
OPERATOR_EMAILS=franco.dgstn@gmail.com

# ─── Production (Firebase App Hosting) ──────────────────────────────────────
# Do NOT set the *_EMULATOR_HOST vars in production. The Admin SDK uses the
# App Hosting runtime service account via Application Default Credentials.
# Set OPERATOR_EMAILS and the NEXT_PUBLIC_FIREBASE_* client config for the
# real project (see apps/web/.env.local.example).
