# Firebase configuration for local development
# Copy this file to .env.staging and/or .env.production
#
# Usage:
#   pnpm start          -> loads .env.staging (default)
#   pnpm run start:prod -> loads .env.production
#
# Only FIREBASE_PROJECT_ID and FIREBASE_API_KEY are required.
# All other Firebase values are derived from the project ID in app.config.js.

# One of: demo-linyup (local emulator, no key needed) | linyup-staging |
# linyup-sandbox | linyup-prod
FIREBASE_PROJECT_ID=

# Required for every real project (staging/sandbox/prod); the emulator project
# accepts any non-empty placeholder value.
FIREBASE_API_KEY=

# Emulator-only: connect to the local Firebase emulators instead of a real
# project. Also implied automatically when FIREBASE_PROJECT_ID=demo-linyup.
EXPO_PUBLIC_USE_EMULATORS=false

# Set once `eas init` has run in apps/mobile (writes extra.eas.projectId and
# enables `updates.url`). Empty until then — OTA stays inert, same as today.
EAS_PROJECT_ID=
