# apps/mobile/.env.staging — `pnpm bootstrap` copies this template there
# (gitignored). It is what `pnpm dev:mobile` / `pnpm start` load; STAGING is the
# member app's default dev target (docs/mobile-roadmap-2026-09.md §2).
#
# Only FIREBASE_PROJECT_ID and FIREBASE_API_KEY matter: every other Firebase
# value is derived from the project id in app.config.js, which REFUSES a real
# project without a key rather than letting the app talk to it with a
# placeholder (that fails later, as auth/invalid-api-key, with nothing to say
# which env file was wrong).
#
#   pnpm start                 -> .env.staging      (this file)
#   pnpm run start:prod        -> .env.production   (copy this file, switch both values)
#   pnpm run start:emulators   -> no env file: demo-linyup + the local emulators;
#                                 the ports come from .env.local, which
#                                 scripts/local-env.mjs writes for this checkout's slot

# One of: linyup-staging | linyup-sandbox | linyup-prod  (demo-linyup needs no file)
FIREBASE_PROJECT_ID=linyup-staging

# The WEB app key of that project: Firebase console → project settings → your
# apps → web app → apiKey. Public by design (it identifies the project, it does
# not authorise anything) but never committed.
FIREBASE_API_KEY=

# Set once `eas init` has run in apps/mobile (writes extra.eas.projectId and
# enables `updates.url`). Empty until then — OTA stays inert.
EAS_PROJECT_ID=
