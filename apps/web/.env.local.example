# Copy this file to .env.local and fill in values from your Firebase project console

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=linyup-staging.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://linyup-staging.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=linyup-staging
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=linyup-staging.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# PostHog product analytics (optional). The public project key (phc_…) is safe to
# embed. Leave blank to disable — initPostHog() no-ops without a key. Host = EU cloud.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Firebase App Check (reCAPTCHA v3). The reCAPTCHA v3 SITE key registered for App
# Check in the Firebase console (public, safe to embed). Leave blank to disable —
# App Check init no-ops without it, and it is always skipped under the emulator.
# Deploy this + confirm tokens flow BEFORE setting APP_CHECK_ENFORCE=true on the
# Cloud Functions (otherwise web clients without a token get rejected).
NEXT_PUBLIC_FIREBASE_APPCHECK_RECAPTCHA_KEY=
# Optional: a debug token (from the browser console / Firebase console) to exercise
# App Check locally against a real project. Never set in production.
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=
