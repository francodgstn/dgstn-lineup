# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

project_id      = "linyup-staging"
billing_account = "XXXXXX-XXXXXX-XXXXXX"

# Exactly one of org_id / folder_id is required when create_project = true.
org_id = "000000000000"
# folder_id = "000000000000"

# From the bootstrap stack output `ci_deploy_sa_email`.
deploy_sa_email = "linyup-ci-deploy@linyup-admin.iam.gserviceaccount.com"

# Optional overrides:
# create_project     = true
# region             = "europe-west6"
# firestore_location = "europe-west6"
# budget_amount      = 100
