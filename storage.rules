rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // ── helpers ────────────────────────────────────────────────────────────────
    function isTeamMemberStorage(teamId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/teams/$(teamId)/team_members/$(request.auth.uid));
    }
    // Org admin of an organization — gates writes to the org website's images.
    function isOrgAdminStorage(orgId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/organizations/$(orgId)/org_members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/organizations/$(orgId)/org_members/$(request.auth.uid)).data.role == 'org_admin';
    }
    // A valid contact session (custom token) scoped to a team — used by the public
    // "Space" web area so a signed-in contact can fetch gated course media.
    function isContactSessionForTeam(teamId) {
      return request.auth != null
        && request.auth.token.teamId == teamId
        && request.auth.token.sessionExpires != null
        && request.auth.token.sessionExpires >= request.time.toMillis();
    }
    // The contact's own live session (custom token whose contactId matches the path).
    function isContactSelf(contactId) {
      return request.auth != null
        && request.auth.token.contactId == contactId
        && request.auth.token.sessionExpires != null
        && request.auth.token.sessionExpires >= request.time.toMillis();
    }
    // The team that owns a contact (resolved from the contact doc, since the Storage
    // path carries no teamId).
    function contactTeamId(contactId) {
      return firestore.get(/databases/(default)/documents/contacts/$(contactId)).data.teamId;
    }
    // True when the course doc (root collection, id == path courseId) is published & free.
    function isPublishedFreeCourse(courseId) {
      return firestore.get(/databases/(default)/documents/courses/$(courseId)).data.status == 'published'
        && firestore.get(/databases/(default)/documents/courses/$(courseId)).data.accessRule.type == 'free';
    }

    // The calling contact session's single active subscription type id.
    function callerCourseSubTypeId() {
      return firestore.get(/databases/(default)/documents/contacts/$(request.auth.token.contactId)).data.get('subscription_type_id', '');
    }
    // Whether the calling contact bought this course (lifetime entitlement).
    function contactPurchasedCourse(courseId) {
      return request.auth != null
        && request.auth.token.contactId != null
        && firestore.exists(/databases/(default)/documents/courses/$(courseId)/purchases/$(request.auth.token.contactId));
    }
    // Tier-aware contact-session read of course MEDIA — mirrors canReadPublishedCourse
    // in firestore.rules. This must exist independently of the Firestore lesson read:
    // Storage has no get/list split (read grants listAll on a {allPaths=**} prefix),
    // and media object paths are predictable timestamps, so a contact could enumerate
    // and download gated media without ever passing the Firestore tier check. Gate the
    // object store on the SAME tiers Firestore enforces.
    function contactMayReadCourseMedia(teamId, courseId) {
      let c = firestore.get(/databases/(default)/documents/courses/$(courseId)).data;
      return isContactSessionForTeam(teamId) && c.status == 'published' && (
           c.accessRule.type == 'free'
        || c.accessRule.type == 'registered'
        || (c.accessRule.type == 'subscription'
            && c.accessRule.subscriptionTypeIds.hasAny([callerCourseSubTypeId()]))
        || (c.accessRule.type == 'purchase'
            && (contactPurchasedCourse(courseId)
                || c.accessRule.get('subscriptionTypeIds', []).hasAny([callerCourseSubTypeId()])
                || (c.get('benefit', null) is map
                    && c.benefit.get('effect', '') == 'included'
                    && c.benefit.get('subscriptionTypeIds', []).hasAny([callerCourseSubTypeId()]))))
      );
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Course media lives under teams/{teamId}/courses/{courseId}/... This more-specific
    // match adds PUBLIC read of free published-course media, and TIER-AWARE contact-session
    // read of gated media, on top of staff access. (Storage grants if ANY matching rule
    // allows; the broad teams/{teamId} match below still applies for writes + staff reads.)
    // The tier IS re-checked here (contactMayReadCourseMedia): the old rule granted any
    // contact of the team read of ANY tier's media, and because Storage read == list and
    // paths are predictable, a free-tier member could enumerate and download a studio's
    // paid subscription/purchase course content for free.
    match /teams/{teamId}/courses/{courseId}/{allPaths=**} {
      allow read: if isPublishedFreeCourse(courseId)
        || isTeamMemberStorage(teamId)
        || contactMayReadCourseMedia(teamId, courseId);
      allow write: if isTeamMemberStorage(teamId)
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|audio/.*|video/.*|application/pdf');
    }

    // Product images live under teams/{teamId}/products/{productId}/... They are
    // shown on the PUBLIC (anonymous, email-only) shop, so reads are open; writes
    // stay staff-only and image-only. (Storage grants if ANY matching rule allows;
    // the broad teams/{teamId} match below still covers staff reads/writes.)
    match /teams/{teamId}/products/{allPaths=**} {
      allow read: if true;
      allow write: if isTeamMemberStorage(teamId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Images embedded in a document's rich-text body live under
    // teams/{teamId}/documents/{documentId}/... A published + public document is
    // shown on the PUBLIC document page, so reads are open; writes stay staff-only
    // and image-only. (Storage grants if ANY matching rule allows; the broad
    // teams/{teamId} match below still covers staff reads/writes.)
    // Rank badge artwork lives under teams/{teamId}/ranking/... A member's belt
    // is shown on the member app and on public surfaces, so reads are open;
    // writes stay staff-only and image-only. Small cap — this is a badge, not a
    // photo. (Storage grants if ANY matching rule allows; the broad
    // teams/{teamId} match below still covers staff reads/writes.)
    match /teams/{teamId}/ranking/{allPaths=**} {
      allow read: if true;
      allow write: if isTeamMemberStorage(teamId)
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /teams/{teamId}/documents/{allPaths=**} {
      allow read: if true;
      allow write: if isTeamMemberStorage(teamId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /teams/{teamId}/{allPaths=**} {
      // Only members of this specific team may access its files
      allow read: if isTeamMemberStorage(teamId);
      // Course media (audio/video) lives under teams/{teamId}/courses/... so we allow
      // larger files and audio/video content types here, scoped to team members.
      allow write: if isTeamMemberStorage(teamId)
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|audio/.*|video/.*|application/pdf');
    }

    // Organization website images (hero/gallery) live under
    // organizations/{orgId}/site/{sectionId}/... They are shown on the PUBLIC org
    // site, so reads are open (also served via the download token); writes are
    // org-admin-only and image-only.
    // The org-level twin of teams/{teamId}/ranking above. An organisation that
    // owns its studios' ranking systems owns their badge artwork with them.
    match /organizations/{orgId}/ranking/{allPaths=**} {
      allow read: if true;
      allow write: if isOrgAdminStorage(orgId)
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /organizations/{orgId}/site/{allPaths=**} {
      allow read: if true;
      allow write: if isOrgAdminStorage(orgId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /contacts/{contactId}/{allPaths=**} {
      // The Storage path carries no teamId, so resolve the owning team from the
      // contact doc and scope access to the contact themselves or that team's staff
      // — no longer any-authenticated-user.
      allow read: if isContactSelf(contactId)
        || isTeamMemberStorage(contactTeamId(contactId));
      allow write: if (isContactSelf(contactId)
          || isTeamMemberStorage(contactTeamId(contactId)))
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }

    match /public/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // In-app feedback screenshots (feedback/{uid}/{uuid}.png). Owner-only,
    // image-only, size-capped. The operator console reads them via Admin SDK
    // (streaming route), which bypasses these rules.
    match /feedback/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
