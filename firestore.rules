rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {


    // Auth and Roles functions
		//-------------------------------------------------------

    // if the .auth property is not set, the user is not signed in
    function isAuthed() {
      return request.auth.uid != null
    }

    function isOwner(res) {
      return res.data.createdBy == request.auth.uid
    }

    // DEPRECATED: Use isTeamMember() instead
    // Kept for backward compatibility during migration
    function isTeacher(res) {
      return res.data.teacher == request.auth.uid
    }

    // return the current users roles
    function getRoles() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles
    }

    // check if the current user has a specific role
    function hasRole(role) {
      //superadmin has all roles (not really nice but I need this)
      return getRoles()["superadmin"] == true
      ||
      (isAuthed() && getRoles()[role] == true);
    }

    // check if the user has any of the given roles (list)
    function hasAnyRole(roles) {
      return isAuthed() && getRoles().keys().hasAny(roles);
    }


    // Team Helper functions
    //-------------------------------------------------------

    // Get the current user's active team ID
    function getUserCurrentTeam() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.currentTeam
    }

    // Check if user is a member of a specific team
    function isTeamMember(teamId) {
      return exists(/databases/$(database)/documents/teams/$(teamId)/team_members/$(request.auth.uid))
    }

    // Check if user is a member of the resource's team (supports both teamId and teacher fields)
    function isMemberOfResourceTeam(res) {
      // Try teamId first (new model), fall back to teacher (old model)
      let teamId = res.data.teamId;
      return teamId != null && isTeamMember(teamId)
    }

    // Check if user has a specific role in a team
    function hasTeamRole(teamId, role) {
      let membership = get(/databases/$(database)/documents/teams/$(teamId)/team_members/$(request.auth.uid)).data;
      let userRole = membership.role;

      // Role hierarchy: owner > manager > viewer
      return userRole == 'owner' ||
             (role == 'manager' && userRole == 'manager') ||
             (role == 'viewer' && (userRole == 'owner' || userRole == 'manager' || userRole == 'viewer'));
    }

    // Organization Helper functions
    //-------------------------------------------------------

    function isOrgMember(orgId) {
      return exists(/databases/$(database)/documents/organizations/$(orgId)/org_members/$(request.auth.uid))
    }

    function hasOrgRole(orgId, role) {
      let membership = get(/databases/$(database)/documents/organizations/$(orgId)/org_members/$(request.auth.uid)).data;
      let userRole = membership.role;
      // org_admin can do everything; org_viewer is read-only
      return userRole == 'org_admin' ||
             (role == 'org_viewer' && userRole == 'org_viewer');
    }

    // Check if the current user is an org_admin of the org that owns the given team
    function isOrgAdminOfTeam(teamId) {
      let orgId = get(/databases/$(database)/documents/teams/$(teamId)).data.get('org_id', null);
      return orgId != null && hasOrgRole(orgId, 'org_admin');
    }

    // Returns true if writing org_membership_* fields is permitted for the current user.
    // Short-circuits to true when the team has no org or the org has not enabled the lock.
    // Triggered only when org_membership_* appear in the write diff — zero extra cost otherwise.
    function orgMembershipWriteAllowed(teamId) {
      let orgId = get(/databases/$(database)/documents/teams/$(teamId)).data.get('org_id', null);
      return orgId == null
        || !get(/databases/$(database)/documents/organizations/$(orgId)).data.get('lock_org_membership', false)
        || get(/databases/$(database)/documents/organizations/$(orgId)/org_members/$(request.auth.uid)).data.get('role', '') == 'org_admin';
    }

    // Check if resource's teamId matches user's current team OR if teacher field matches user (backward compat)
    function belongsToUserTeam(res) {
      return (res.data.teamId != null && res.data.teamId == getUserCurrentTeam() && isTeamMember(res.data.teamId))
             || isTeacher(res);
    }

    function isSelfContact(contactId) {
      return request.auth != null
             && request.auth.token.contactId == contactId
             && request.auth.token.sessionExpires != null
             && request.auth.token.sessionExpires >= request.time.toMillis();
    }

    function sharesContactEmail(res) {
      return request.auth != null
             && request.auth.token.email != null
             && res.data.email != null
             && request.auth.token.email == res.data.email;
    }


    // Helper functions
    //-------------------------------------------------------
    // function notUpdating(field) {
    //   return !(field in request.resource.data) || resource.data[field] == request.resource.data[field]
    // }

    // function eventIsClosed(eventId){
    //    get(/databases/$(database)/documents/events/$(eventId));
    // }


    // DB rules
    //-------------------------------------------------------
    //
    // You'll forget this :)
    //
    //	resource.data --> current data in db
    //	request.resource.data --> data in the request

    // Private user profiles
    match /users/{userId} {
      // Users can only read their own profile; admins can read any. Restricts PII (email) exposure.
      allow read: if (isAuthed() && request.auth.uid == userId) || hasRole('admin');
      allow write: if request.auth.uid == userId;

      // Activity log sub-collection
      match /activity_log/{activityLogId} {
        allow read: if (isAuthed() && request.auth.uid == userId) || hasRole('admin');
        allow write: if isOwner(get(/databases/$(database)/documents/users/$(userId))) || hasRole('admin');
      }

      // Reports sub-collection
      match /user_weekly_reports/{weeklyReportId} {
        allow read;
        allow write: if isOwner(get(/databases/$(database)/documents/users/$(userId))) || hasRole('admin');
      }

      // Public profile sub-collection
      match /public_profile/{publicProfileUserId} {
        allow read;
        allow write: if isOwner(get(/databases/$(database)/documents/users/$(userId))) || hasRole('admin');
      }

      // DEPRECATED: Sessions Tags sub-collection (moved to teams/{teamId}/sessions_tags)
      // Kept for backward compatibility during migration
      match /sessions_tags/{tagId} {
        allow read;
        allow write: if isOwner(get(/databases/$(database)/documents/users/$(userId))) || hasRole('admin');
      }

      // DEPRECATED: Places sub-collection (moved to teams/{teamId}/team_places)
      // Kept for backward compatibility during migration
      match /user_places/{tagId} {
        allow read;
        allow write: if isOwner(get(/databases/$(database)/documents/users/$(userId))) || hasRole('admin');
      }

    }

    // Teams collection
    match /teams/{teamId} {
      // Team members can read their own team. A user can also read a team they created
      // (needed during the signup flow before they are formally added as a member).
      // isAuthed() guard must come first — isTeamMember() accesses request.auth.uid which
      // throws an evaluation error (not just false) when request.auth is null.
      allow read: if isAuthed() && (
               isTeamMember(teamId)
               || resource.data.get('createdBy', null) == request.auth.uid);

      // Only team owners can update team details
      allow update: if isTeamMember(teamId) && hasTeamRole(teamId, 'owner');

      // Only users with admin role can create teams, OR the user is provisioning their own first team
      allow create: if isAuthed() && (hasRole('admin') || request.resource.data.createdBy == request.auth.uid);

      // Only team owners can delete teams
      allow delete: if isTeamMember(teamId) && hasTeamRole(teamId, 'owner');

      // Public profile subcollection - minimal public data for portal
      match /public_profile/{publicProfileId} {
        // Anyone can read (needed for public portal access)
        allow read;
        // Team members can update portal settings (appearance, links, booking config)
        allow write: if isTeamMember(teamId);
      }

      // Team members subcollection
      match /team_members/{memberId} {
        // Team members can read the member list
        // Also allow users to read their own membership record (needed for initial team lookup)
        allow read: if isTeamMember(teamId) || memberId == request.auth.uid;

        // Only owners can add/remove/update team members, OR a user self-provisioning as owner on signup.
        // The Free plan is single-user: an owner cannot create membership docs for OTHER users
        // (invitation acceptance runs through Cloud Functions / Admin SDK and is gated there).
        allow write: if (hasTeamRole(teamId, 'owner') &&
                       (memberId == request.auth.uid ||
                        get(/databases/$(database)/documents/teams/$(teamId)).data.get('plan', 'free') != 'free')) ||
                       (isAuthed() && memberId == request.auth.uid &&
                        request.resource.data.role == 'owner' &&
                        request.resource.data.userId == request.auth.uid);
      }

      // Activity log subcollection (moved from users/{userId}/activity_log)
      match /activity_log/{activityLogId} {
        // All team members can read activity log
        allow read: if isTeamMember(teamId);

        // Cloud functions can write, team members can read
        allow write: if false; // Only cloud functions should write to activity log
      }

      // Team weekly reports subcollection (moved from users/{userId}/user_weekly_reports)
      match /team_weekly_reports/{weeklyReportId} {
        // All team members can read weekly reports
        allow read: if isTeamMember(teamId);

        // Cloud functions can write, team members can read
        allow write: if false; // Only cloud functions should write to weekly reports
      }

      // Team places subcollection (moved from users/{userId}/user_places)
      match /team_places/{placeId} {
        // All team members can read places
        allow read: if isTeamMember(teamId);

        // Cloud functions can write (counters managed by functions)
        allow write: if false; // Only cloud functions should write to places
      }

      // Team sessions tags subcollection (moved from users/{userId}/sessions_tags)
      match /sessions_tags/{tagId} {
        // All team members can read tags
        allow read: if isTeamMember(teamId);

        // Cloud functions can write (counters managed by functions)
        allow write: if false; // Only cloud functions should write to tags
      }

      // Team invitations subcollection
      match /team_invitations/{invitationId} {
        // Team members can read invitations
        allow read: if isTeamMember(teamId);

        // Only cloud functions can write (send, accept, cancel invitations)
        allow write: if false;
      }

      // Contact requests subcollection (data update requests, etc.)
      match /contact_requests/{requestId} {
        // Team members can read requests
        allow read: if isTeamMember(teamId);

        // Only cloud functions can write (create, approve, discard)
        allow write: if false;
      }

      // Team alerts subcollection (non-contact-specific alerts)
      match /team_alerts/{alertId} {
        // Team members can read alerts
        allow read: if isTeamMember(teamId);

        // Managers and owners can create, update, delete alerts
        allow write: if hasTeamRole(teamId, 'owner') || hasTeamRole(teamId, 'manager');
      }

      // Alert presets subcollection (reusable alert templates)
      match /alert_presets/{presetId} {
        // Team members can read presets
        allow read: if isTeamMember(teamId);

        // Only owners can manage presets
        allow write: if hasTeamRole(teamId, 'owner');
      }

      // Payment gateway integrations (Stripe / Payrexx config — secrets stored in Secret Manager)
      match /integrations/{integrationId} {
        // Only owners can view or modify gateway configuration
        allow read, write: if hasTeamRole(teamId, 'owner');
      }

      // Installed plugins — teams enable/configure add-on plugins here.
      // All members can read (needed by automation UI and nav display).
      // Studio/Org owners install client-side (plugins are included). Coach plans
      // activate plugins as PAID add-ons via the activatePluginAddon Cloud
      // Function (admin SDK), so client writes are denied on Coach — this stops
      // a coach self-granting a paid plugin for free.
      match /installed_plugins/{pluginId} {
        allow read:  if isTeamMember(teamId);
        allow write: if hasTeamRole(teamId, 'owner')
                     && get(/databases/$(database)/documents/teams/$(teamId)).data.get('plan', '') in ['studio', 'organization'];
      }

      // Subscription types subcollection (team-defined subscription plans and aggregators)
      match /subscription_types/{subscriptionTypeId} {
        // Only team members can read — prevents other teams from enumerating pricing plans.
        allow read: if isTeamMember(teamId);

        // Managers and owners can create, update, delete subscription types
        allow write: if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
      }

      // Subscription transition log (team-level event log for funnel/pattern analytics)
      match /subscription_transitions/{transitionId} {
        allow read: if isTeamMember(teamId) || hasRole('admin');
        allow write: if false; // written only by Cloud Functions
      }

      // Outreach email templates (re-engagement campaigns)
      match /outreach_templates/{templateId} {
        allow read: if isTeamMember(teamId);
        allow write: if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
      }

      // Automation rules (no-show triggers, future expansion)
      match /automation_rules/{ruleId} {
        allow read: if isTeamMember(teamId);
        allow write: if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
      }

      // Automation execution logs — managers can read; only functions write (Admin SDK bypasses rules)
      match /automation_logs/{logId} {
        allow read: if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
        allow write: if false;
      }

      // Shared contact list filters — saved by managers, visible to all team members
      match /contact_filters/{filterId} {
        allow read:  if isTeamMember(teamId);
        allow write: if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
      }

      // Contact Groups plugin — nested member groups (parent_id hierarchy).
      // Membership lives on contacts/{id}.group_ids, covered by the contacts rules.
      match /contact_groups/{groupId} {
        allow read:  if isTeamMember(teamId);
        allow write: if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
      }

      // Inbound webhook endpoints — manager/owner manage; the inboundWebhook function
      // reads via Admin SDK (collectionGroup query) so no client read rule needed there.
      match /webhook_endpoints/{endpointId} {
        allow read:   if isTeamMember(teamId);
        allow write:  if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
      }

      // Payment events (Payrexx) — immutable audit trail written by handlePayrexxWebhook.
      // Managers and owners can read; no client writes allowed.
      match /payment_events/{eventId} {
        allow read:  if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
        allow write: if false;
      }

      // Custom event types (team-level; org-level event types live under organizations/{orgId}/event_types)
      match /event_types/{typeId} {
        allow read:   if isTeamMember(teamId);
        allow create: if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
        allow update: if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
        allow delete: if hasTeamRole(teamId, 'owner');
      }

      // Rebuild jobs subcollection (background score history rebuild tasks)
      match /rebuild_jobs/{jobId} {
        // Owners and managers can read their own job status (for onSnapshot polling)
        allow read: if hasTeamRole(teamId, 'owner') || hasTeamRole(teamId, 'manager');
        // Only cloud functions can write (triggerScoresRebuild creates, processScoresRebuildJob updates)
        allow write: if false;
      }

      // Leaderboard subcollection (gamification scores for student app)
      match /leaderboard/{leaderboardId} {
        // Team members (web app) and students (student app via token) can read
        allow read: if isTeamMember(teamId)
                    || (request.auth != null
                        && request.auth.token.teamId == teamId
                        && request.auth.token.sessionExpires != null
                        && request.auth.token.sessionExpires >= request.time.toMillis());
        // Only cloud functions can write
        allow write: if false;
      }

      // Historical leaderboard snapshots (one doc per YYYY-MM)
      match /leaderboard_history/{month} {
        allow read: if isTeamMember(teamId)
                    || (request.auth != null
                        && request.auth.token.teamId == teamId
                        && request.auth.token.sessionExpires != null
                        && request.auth.token.sessionExpires >= request.time.toMillis());
        allow write: if false;
      }

      // Monthly session counters (written by trackSessions trigger)
      match /session_counts/{month} {
        allow read: if isTeamMember(teamId);
        allow write: if false;
      }

      // Org access requests — org admins request view/manage access to this team.
      // Owners and managers can read requests and approve/deny server-side;
      // only cloud functions write (requestTeamAccess creates, approveTeamAccess updates).
      match /org_access_requests/{orgId} {
        allow read: if hasTeamRole(teamId, 'owner') || hasTeamRole(teamId, 'manager');
        allow write: if false;
      }
    }

    // Public user profiles (deprecated - now using users/{userId}/public_profile subcollection)
    // This rule is kept for backwards compatibility during migration but can be removed
    // once all data is migrated to the subcollection pattern
    match /users_public/{userId} {
      allow read;
      allow write: if false;
    }

    // Projects
    match /projects/{projectId} {
      // Only projects you own can be viewed
      allow create: if isOwner(request.resource);
      allow read, update, delete: if isOwner(resource);
      // Rules apply to all child collections
      match /{allChildren=**} {
        allow read, write: if isOwner(get(/databases/$(database)/documents/projects/$(projectId)));
      }
    }

    // Contacts
    match /contacts/{contactId} {
      // Create: Must belong to user's current team (new) OR match user ID (old)
      allow create: if (request.resource.data.teamId == getUserCurrentTeam() && isTeamMember(request.resource.data.teamId))
                       || isTeacher(request.resource)
                       || hasRole('admin');

      // Read/Update/Delete: Must be member of contact's team OR old teacher-based access
      allow read: if belongsToUserTeam(resource)
                   || hasRole('admin')
                   || isSelfContact(contactId)
                   || sharesContactEmail(resource)
                   || isOrgAdminOfTeam(resource.data.teamId);
      allow update: if (belongsToUserTeam(resource)
                       || hasRole('admin')
                       || (isSelfContact(contactId)
                           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['weight', 'last_seen_at'])))
                      && (
                        !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['org_membership_status', 'org_membership_active', 'org_membership_expiration'])
                        || orgMembershipWriteAllowed(resource.data.teamId)
                        || hasRole('admin')
                      );
      allow delete: if belongsToUserTeam(resource) || hasRole('admin');

      // Subscription history subcollection — full CRUD for team members
      match /subscription_history/{historyId} {
        allow read: if belongsToUserTeam(get(/databases/$(database)/documents/contacts/$(contactId)))
                      || hasRole('admin');
        allow create, update, delete:
          if belongsToUserTeam(get(/databases/$(database)/documents/contacts/$(contactId)))
          || hasRole('admin');
      }

      // Goals subcollection
      // Coaches (team members) have full CRUD.
      // Students can create goals (created_by must be 'student') and update the status field only.
      match /goals/{goalId} {
        allow read: if belongsToUserTeam(get(/databases/$(database)/documents/contacts/$(contactId)))
                      || hasRole('admin')
                      || isSelfContact(contactId);
        allow create: if belongsToUserTeam(get(/databases/$(database)/documents/contacts/$(contactId)))
                         || hasRole('admin')
                         || (isSelfContact(contactId) && request.resource.data.created_by == 'student');
        allow update: if belongsToUserTeam(get(/databases/$(database)/documents/contacts/$(contactId)))
                         || hasRole('admin')
                         || (isSelfContact(contactId) && resource.data.created_by == 'student');
        allow delete: if belongsToUserTeam(get(/databases/$(database)/documents/contacts/$(contactId)))
                         || hasRole('admin')
                         || (isSelfContact(contactId) && resource.data.created_by == 'student');

        // Goal evaluations subcollection
        // Coaches have full CRUD. Students can create and edit their own evaluations.
        match /evaluations/{evalId} {
          allow read: if belongsToUserTeam(get(/databases/$(database)/documents/contacts/$(contactId)))
                        || hasRole('admin')
                        || isSelfContact(contactId);
          allow create: if belongsToUserTeam(get(/databases/$(database)/documents/contacts/$(contactId)))
                           || hasRole('admin')
                           || (isSelfContact(contactId) && request.resource.data.evaluated_by == 'student');
          allow update: if belongsToUserTeam(get(/databases/$(database)/documents/contacts/$(contactId)))
                           || hasRole('admin')
                           || (isSelfContact(contactId) && resource.data.evaluated_by == 'student');
          allow delete: if belongsToUserTeam(get(/databases/$(database)/documents/contacts/$(contactId)))
                           || hasRole('admin');
        }
      }

      // Training check-ins subcollection
      // Coaches have full CRUD. Students can create and update their own check-ins (filled_by must be 'student').
      match /training_checkins/{checkinId} {
        allow read: if belongsToUserTeam(get(/databases/$(database)/documents/contacts/$(contactId)))
                      || hasRole('admin')
                      || isSelfContact(contactId);
        allow create: if belongsToUserTeam(get(/databases/$(database)/documents/contacts/$(contactId)))
                         || hasRole('admin')
                         || (isSelfContact(contactId) && request.resource.data.filled_by == 'student');
        allow update: if belongsToUserTeam(get(/databases/$(database)/documents/contacts/$(contactId)))
                         || hasRole('admin')
                         || (isSelfContact(contactId) && resource.data.filled_by == 'student');
        allow delete: if belongsToUserTeam(get(/databases/$(database)/documents/contacts/$(contactId)))
                         || hasRole('admin');
      }

      // Rules apply to all other child collections
      match /{allChildren=**} {
        allow read: if belongsToUserTeam(get(/databases/$(database)/documents/contacts/$(contactId)))
                      || hasRole('admin')
                      || isSelfContact(contactId)
                      || sharesContactEmail(get(/databases/$(database)/documents/contacts/$(contactId)));
        allow write: if belongsToUserTeam(get(/databases/$(database)/documents/contacts/$(contactId))) || hasRole('admin');
      }

    }

    // Checkins — created and updated exclusively via addEventCheckin Cloud Function (admin SDK).
    // Direct client creates are denied to prevent bypassing server-side confirmation logic.
    // The manual confirm/unconfirm toggle (is_completed) is the only direct client write allowed,
    // and only for team managers or owners.
    match /checkins/{checkin} {
      allow create: if false; // addEventCheckin Cloud Function only
      allow update: if hasTeamRole(resource.data.teamId, 'manager') || hasRole('admin')
                       || isOrgAdminOfTeam(resource.data.teamId);
      allow delete: if hasTeamRole(resource.data.teamId, 'manager') || hasRole('admin')
                       || isOrgAdminOfTeam(resource.data.teamId);
      allow read:   if belongsToUserTeam(resource) || hasRole('admin')
                       || isOrgAdminOfTeam(resource.data.teamId);
    }

    // Events — team-scoped or org-scoped
    // Org events (scope=='org') are visible to all teams in that org.
    match /events/{event} {
      allow create: if belongsToUserTeam(request.resource)
                    || (isAuthed() && request.resource.data.scope == 'org'
                        && request.resource.data.orgId != null
                        && hasOrgRole(request.resource.data.orgId, 'org_admin'))
                    || hasRole('admin');
      allow read:   if belongsToUserTeam(resource)
                    || (isAuthed() && resource.data.scope == 'org'
                        && resource.data.orgId != null
                        && isOrgMember(resource.data.orgId))
                    || (isAuthed() && resource.data.scope == 'org'
                        && resource.data.orgId != null
                        && get(/databases/$(database)/documents/teams/$(getUserCurrentTeam())).data.org_id == resource.data.orgId)
                    || hasRole('admin');
      allow update: if belongsToUserTeam(resource)
                    || (isAuthed() && resource.data.scope == 'org'
                        && resource.data.orgId != null
                        && hasOrgRole(resource.data.orgId, 'org_admin'))
                    || hasRole('admin');
      allow delete: if hasRole('admin');

      // Per-event categories (used by fighting_cup and any plugin with hasCategories)
      match /categories/{category} {
        allow read:  if belongsToUserTeam(get(/databases/$(database)/documents/events/$(event)));
        allow write: if belongsToUserTeam(get(/databases/$(database)/documents/events/$(event))) || hasRole('admin');
      }

      // RSVP attendees — written by Cloud Functions
      match /attendees/{attendee} {
        allow read:  if belongsToUserTeam(get(/databases/$(database)/documents/events/$(event)));
        allow write: if false;
      }

      // Invitations — written and read exclusively by Cloud Functions (admin SDK).
      // The portal uses getEventInvitationDetails() callable, not direct client reads.
      match /invitations/{invitation} {
        allow read:  if false;
        allow write: if false;
      }
    }

    // Legacy global categories (HMD-only — read-only going forward)
    match /categories/{category} {
      allow read;
    }

    // Sessions
    match /sessions/{session} {
      // Create: Must belong to user's team and cannot directly set location/tags
    	allow create: if (belongsToUserTeam(request.resource) || hasRole('admin'))
                       && (!request.resource.data.keys().hasAny(['location', 'tags']));

      // Update: Must be team member and cannot update location/tags directly
      allow update: if (belongsToUserTeam(resource) || hasRole('admin'))
                       && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['location', 'tags']));

      // Delete: Must be team member and session must not have location, tags, or participants
      allow delete: if (belongsToUserTeam(resource) || hasRole('admin')) &&
      (
        (!resource.data.keys().hasAll(['location']) || resource.data.location == null) &&
        (!resource.data.keys().hasAll(['tags']) || resource.data.tags == null) &&
        (!resource.data.keys().hasAll(['participants_count']) || resource.data.participants_count == 0)
      );

      // Read: Must be team member
      allow read: if belongsToUserTeam(resource) || hasRole('admin');

      // participants sub-collection
      match /participants/{participantId} {
        allow read, write: if belongsToUserTeam(get(/databases/$(database)/documents/sessions/$(session))) || hasRole('admin');
        // Allow contacts to read their own participant doc (student app)
        allow read: if isSelfContact(participantId);
      }

      // bookings sub-collection (portal reservations, separate from confirmed attendance)
      match /bookings/{bookingId} {
        allow read, write: if belongsToUserTeam(get(/databases/$(database)/documents/sessions/$(session))) || hasRole('admin');
        // Allow contacts to read their own booking doc (student app)
        allow read: if isSelfContact(bookingId);
      }

      // public_profile sub-collection (for trial booking)
      match /public_profile/{publicProfileId} {
        allow read;  // Public read access
        allow write: if false;  // Only cloud functions can write
      }
    }

    // Coach Availability Templates (recurring slot patterns defined by managers)
    match /coach_availability/{templateId} {
      // GET: resource.data is available
      allow get: if isAuthed() && isTeamMember(resource.data.teamId);
      // LIST: resource.data is not reliably available for query rules — use currentTeam
      allow list: if isAuthed() && isTeamMember(getUserCurrentTeam());
      allow create: if isAuthed() && hasTeamRole(request.resource.data.teamId, 'manager');
      allow update: if isAuthed() && hasTeamRole(resource.data.teamId, 'manager');
      allow delete: if false; // soft delete only
    }

    // Coach Slots collection removed — coaching sessions now live in `sessions`
    // with activityType === 'coaching'. Public access via sessions/{id}/public_profile.

    // Session Series (recurring sessions)
    match /session_series/{seriesId} {
      allow create: if belongsToUserTeam(request.resource) || hasRole('admin');
      allow read: if belongsToUserTeam(resource) || hasRole('admin');
      allow update: if belongsToUserTeam(resource) || hasRole('admin');
      allow delete: if belongsToUserTeam(resource) || hasRole('admin');
    }

    // Activities (class types)
    match /activities/{activityId} {
      allow create: if belongsToUserTeam(request.resource) || hasRole('admin');
      allow read: if belongsToUserTeam(resource) || hasRole('admin');
      allow update: if belongsToUserTeam(resource) || hasRole('admin');
      allow delete: if belongsToUserTeam(resource) || hasRole('admin');

      // public_profile sub-collection (for trial booking)
      match /public_profile/{publicProfileId} {
        allow read;  // Public read access
        allow write: if false;  // Only cloud functions can write
      }
    }

    // ----------------------------------------------
    // Group queries
    // ----------------------------------------------

    // contact_weekly_reports
    match /{path=**}/contact_weekly_reports/{contactWeeklyReportId} {
      allow read: if request.auth != null && (
        resource.data.teamId != null && isTeamMember(resource.data.teamId)
      );
    }

    // contact_alerts
    match /{path=**}/contact_alerts/{contactAlertId} {
      allow read: if request.auth != null && (
        (resource.data.teamId != null && isTeamMember(resource.data.teamId)) ||
        isTeacher(get(/databases/$(database)/documents/contacts/$(resource.data.contact))) ||
        hasRole('admin')
      );
    }

    // team_alerts (collection group for team-level alerts)
    match /{path=**}/team_alerts/{teamAlertId} {
      allow read: if request.auth != null && (
        resource.data.teamId != null && isTeamMember(resource.data.teamId)
      );
    }

    // bookings (collection group for dashboard heatmap query)
    match /{path=**}/bookings/{bookingId} {
      allow read: if request.auth != null && (
        resource.data.teamId != null && isTeamMember(resource.data.teamId)
      );
    }

    // public_profile (collection group for trial booking)
    match /{path=**}/public_profile/{publicProfileId} {
      allow read;  // Public read access for trial booking
      allow write: if false;  // Only cloud functions can write
    }

    // team_members (collection group for user membership queries)
    match /{path=**}/team_members/{memberId} {
      allow read: if request.auth != null && (
        resource.data.teamId != null && isTeamMember(resource.data.teamId)
      );
      allow write: if false;  // Must go through specific team path
    }

    // team_invitations (collection group for invitation token queries)
    match /{path=**}/team_invitations/{invitationId} {
      allow read: if false;  // Only cloud functions can query by token
      allow write: if false;  // Only cloud functions can write
    }

    // ----------------------------------------------
    // Membership Signup (Public)
    // ----------------------------------------------

    // Verification codes - no direct client access
    // All operations handled via cloud functions
    match /verification_codes/{codeId} {
      allow read: if false;
      allow write: if false;
    }

    // ----------------------------------------------
    // Authentication Tokens
    // ----------------------------------------------

    // Scoped auth tokens - generated by student app for booking, membership, etc.
    // All operations handled via cloud functions
    match /auth_tokens/{tokenId} {
      allow read: if false;
      allow write: if false;
    }

    // Booking verification codes - for email-based authentication in portal
    // All operations handled via cloud functions
    match /booking_verification_codes/{codeId} {
      allow read: if false;
      allow write: if false;
    }

    // ----------------------------------------------
    // Referral System
    // ----------------------------------------------

    // Referral code lookup table — only cloud functions read/write
    match /referral_codes/{code} {
      allow read: if false;
      allow write: if false;
    }

    // Referral tracking — team members can read; only cloud functions write
    match /referrals/{referralId} {
      // Single document GET: resource.data is available, verify team membership directly
      allow get: if isAuthed() && (
        isTeamMember(resource.data.team_id) || hasRole('admin')
      );
      // Collection LIST: resource.data is NOT available for query rules.
      // Security relies on the app always filtering by team_id == user's team.
      allow list: if isAuthed();
      allow write: if false;
    }

    // ----------------------------------------------
    // Online Courses plugin (lightweight LMS) — authoring only (admin web)
    // Team members read; managers+ write. Org-scope read added in a later slice.
    // ----------------------------------------------
    match /courses/{courseId} {
      // Single document GET: resource.data is available, verify team membership directly
      allow get: if isAuthed() && isTeamMember(resource.data.teamId);
      // Collection LIST: resource.data is NOT available for query rules.
      // Security relies on the app always filtering by teamId == user's team.
      allow list: if isAuthed();
      allow create: if hasTeamRole(request.resource.data.teamId, 'manager');
      allow update, delete: if hasTeamRole(resource.data.teamId, 'manager');

      // modules + lessons inherit the parent course's team
      match /modules/{moduleId} {
        allow read: if isAuthed()
          && isTeamMember(get(/databases/$(database)/documents/courses/$(courseId)).data.teamId);
        allow write: if hasTeamRole(get(/databases/$(database)/documents/courses/$(courseId)).data.teamId, 'manager');
      }
      match /lessons/{lessonId} {
        allow read: if isAuthed()
          && isTeamMember(get(/databases/$(database)/documents/courses/$(courseId)).data.teamId);
        allow write: if hasTeamRole(get(/databases/$(database)/documents/courses/$(courseId)).data.teamId, 'manager');
      }
    }

    // ----------------------------------------------
    // SaaS Subscriptions (Lineup-specific)
    // Billing state managed exclusively by Cloud Functions (Stripe webhook handler)
    // entity_id may be a teamId or an orgId depending on entity_type
    // ----------------------------------------------
    match /saas_subscriptions/{entityId} {
      allow read: if (isTeamMember(entityId) && hasTeamRole(entityId, 'owner'))
                  || (isOrgMember(entityId) && hasOrgRole(entityId, 'org_admin'));
      allow write: if false; // Cloud Functions only
    }

    // Rate-limit log written by createCheckoutSession Cloud Function
    match /saas_checkout_attempts/{docId} {
      allow read:  if false;
      allow write: if false; // Cloud Function only
    }

    // ----------------------------------------------
    // Organizations (multi-team tier)
    // ----------------------------------------------
    match /organizations/{orgId} {
      allow read: if isOrgMember(orgId);
      allow create: if isAuthed() && request.resource.data.createdBy == request.auth.uid;
      allow update: if hasOrgRole(orgId, 'org_admin');
      allow delete: if false; // Cloud Functions only

      match /org_members/{memberId} {
        // A user can always read their own membership doc (needed for collectionGroup sidebar query)
        allow read: if isOrgMember(orgId) || memberId == request.auth.uid;
        // org_admin can manage members; creator can self-provision as org_admin on org creation
        allow write: if hasOrgRole(orgId, 'org_admin')
                     || (isAuthed()
                         && memberId == request.auth.uid
                         && request.resource.data.role == 'org_admin'
                         && request.resource.data.userId == request.auth.uid);
        allow delete: if hasOrgRole(orgId, 'org_admin');
      }

      match /org_teams/{teamId} {
        allow read: if isOrgMember(orgId) || isTeamMember(teamId);
        allow write: if false; // Cloud Functions only
      }

      match /org_invitations/{invId} {
        allow read: if isOrgMember(orgId)
                    || (isAuthed() && resource.data.inviteeEmail == request.auth.token.email);
        allow write: if false; // Cloud Functions only
      }

      match /membership_statuses/{statusId} {
        allow read:   if isOrgMember(orgId);
        allow write:  if hasOrgRole(orgId, 'org_admin');
        allow delete: if hasOrgRole(orgId, 'org_admin');
      }

      match /team_access_requests/{teamId} {
        // Org admin can read all requests; team owner can read their own
        allow read: if hasOrgRole(orgId, 'org_admin') || (isAuthed() && isTeamMember(teamId) && hasTeamRole(teamId, 'owner'));
        // Only org admin can create/update requests (approval done server-side)
        allow write: if hasOrgRole(orgId, 'org_admin');
      }

      // SMTP and other org-level integrations (password stored encrypted)
      match /integrations/{integrationId} {
        allow read:   if isOrgMember(orgId);
        allow write:  if hasOrgRole(orgId, 'org_admin');
        allow delete: if hasOrgRole(orgId, 'org_admin');
      }
    }

    // ── Early access requests (pre-launch landing page) ───────────────────────
    // Public unauthenticated write — only email, createdAt, source allowed.
    // Read/update/delete only via Admin SDK (operator console).
    match /early_access_requests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'createdAt', 'source'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 320;
      allow read, update, delete: if false;
    }

    // ── Platform metric snapshots (operator console) ──────────────────────────
    // Written by capturePlatformMetrics (Admin SDK) and read by the operator
    // console (Admin SDK). No client access.
    match /platform_metrics/{date} {
      allow read, write: if false;
    }

  }
}
