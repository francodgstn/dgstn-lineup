{
  "projects": {
    "default": "demo-linyup",
    "sandbox": "linyup-sandbox",
    "staging": "linyup-staging",
    "production": "linyup-prod"
  },
  "targets": {
    "linyup-sandbox": {
      "hosting": {
        "app": ["linyup-sandbox"],
        "landing": ["linyup-sandbox-landing"]
      }
    },
    "linyup-staging": {
      "hosting": {
        "app": ["linyup-staging"],
        "landing": ["linyup-staging-landing"]
      }
    },
    "linyup-prod": {
      "hosting": {
        "app": ["linyup-prod"],
        "landing": ["linyup-prod-landing"]
      }
    }
  }
}
